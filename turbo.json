{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["templates/manifest.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/scss/_prop-config.gen.scss",
        "!src/scss/_prop-config-full.gen.scss",
        "!src/scss/base/tokens/_tokens.gen.scss"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "src/scss/_prop-config.gen.scss",
        "src/scss/_prop-config-full.gen.scss",
        "src/scss/base/tokens/_tokens.gen.scss"
      ]
    },
    "lism-site#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/templates/**/screenshots/**/*.png",
        "!$TURBO_ROOT$/templates/**/screenshots/_baseline/**",
        "!$TURBO_ROOT$/templates/**/screenshots/_diff/**",
        "!$TURBO_ROOT$/templates/**/screenshots/_temp/**"
      ],
      "outputs": ["dist/**"]
    },
    "@lism-css/mcp#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/lism-css-guide/**"],
      "outputs": ["dist/**"]
    },
    "@lism-css/mockup#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "types/**"]
    },
    "build:css": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!src/scss/_prop-config.gen.scss",
        "!src/scss/_prop-config-full.gen.scss",
        "!src/scss/base/tokens/_tokens.gen.scss"
      ],
      "outputs": ["dist/css/**", "src/scss/_prop-config.gen.scss", "src/scss/_prop-config-full.gen.scss", "src/scss/base/tokens/_tokens.gen.scss"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lism-css#test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "@lism-css/mcp#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/lism-css-guide/**",
        "$TURBO_ROOT$/apps/site/src/content/ja/**/*.mdx",
        "$TURBO_ROOT$/apps/site/src/lib/contentSlug.ts"
      ],
      "outputs": []
    },
    "@lism-css/plugin#test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "@lism-css/mockup#test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lism-css#lint": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lism-css#typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "format": {
      "cache": false
    },
    "dev": {
      "cache": false
    },
    "start": {
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "build:mcp-data": {
      "dependsOn": ["^build"],
      "outputs": ["packages/mcp/src/data/*.json"],
      "inputs": [
        "skills/lism-css-guide/*.md",
        "apps/site/src/content/ja/**/*.mdx",
        "packages/lism-css/config/defaults/tokens.ts",
        "packages/lism-css/config/defaults/props.ts",
        "packages/lism-css/src/scss/_prop-config.gen.scss",
        "packages/lism-css/src/scss/_prop-config-full.gen.scss",
        "packages/lism-css/src/scss/base/tokens/_tokens.gen.scss"
      ]
    },
    "@lism-css/ui#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.prettierrc*"],
      "outputs": ["dist/**", "registry-index.json", "package.json"]
    }
  }
}
