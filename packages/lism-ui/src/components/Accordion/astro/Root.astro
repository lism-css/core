---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Lism } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';

import '../_style.css';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    allowMultiple?: boolean;
  };

const { class: className, as = 'div', allowMultiple, ...props } = Astro.props;
---

{/* レイアウトが必要な場合は layout="stack" などで指定する */}
<Lism as={as} class={atts(className, 'b--accordion')} data-allow-multiple={allowMultiple ? '' : undefined} {...props}><slot /></Lism>

<script>
  import { setAccordionForAstro } from '../setAccordion';
  setAccordionForAstro();
</script>
