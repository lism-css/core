---
import type { HTMLTag, Polymorphic } from 'astro/types';
import type { AstroLismBaseProps } from 'lism-css/astro';
import { Grid } from 'lism-css/astro';
import atts from 'lism-css/lib/helper/atts';
import buildModifierClass from '../../../helper/buildModifierClass';
import TabList from './List.astro';
import uuid from '../../../helper/uuid.js';

import transformTabitems from './transformTabitems.js';

import '../_style.css';

type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{ as: Tag }> &
  AstroLismBaseProps & {
    defaultIndex?: number;
    tabId?: string;
    listProps?: AstroLismBaseProps;
    variant?: string;
  };

// propsの取得
const { defaultIndex = 1, tabId = '', listProps = {}, variant = 'default', class: className, ...props } = Astro.props;

// tabID生成
const theTabID = tabId ? tabId : uuid();

// 子要素の方から順番に処理されていくので、文字列処理でデータを抽出
const { btns, panels } = transformTabitems(await Astro.slots.render('default'), theTabID, defaultIndex);

const hasItems = btns.length > 0;
---

<Grid class={atts(className, buildModifierClass('b--tabs', { variant }))} {...props}>
  {
    hasItems && (
      <TabList {...listProps}>
        {btns.map((btn, index) => {
          return <Fragment key={index} set:html={btn} />;
        })}
      </TabList>
    )
  }
  {
    panels.map((panel, index) => {
      return <Fragment key={index} set:html={panel} />;
    })
  }
  {!hasItems && <slot />}
</Grid>

<script>
  import { setTabsForAstro } from '../setTabs';
  setTabsForAstro();
</script>
