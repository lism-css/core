---
interface Props {
  size?: string | number;
  width?: string | number;
  height?: string | number;
  fill?: string;
  viewBox?: string;
  path?: string;
  __html?: string;
  [key: string]: unknown;
}
// Astroのスプレッドは明示属性を上書きせず両方出力するため、利用側が上書きできる属性はここで取り出す。
let { size = '1em', width = size, height = size, fill = 'currentColor', viewBox = '0 0 24 24', path, __html, ...props } = Astro.props || {};
---

{
  __html ? (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} width={width} height={height} fill={fill} focusable="false" {...props}>
      <Fragment set:html={__html} />
    </svg>
  ) : (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox} width={width} height={height} fill={fill} focusable="false" {...props}>
      {path && <path d={path} />}
      <slot />
    </svg>
  )
}
