{
  "name": "@lism-css/mcp",
  "version": "0.31.0",
  "description": "MCP server for lism-css documentation and API reference.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "lism-css",
    "css",
    "documentation"
  ],
  "homepage": "https://lism-css.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lism-css/core/tree/main/packages/mcp"
  },
  "type": "module",
  "bin": {
    "lism-mcp": "./bin/lism-mcp.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "build": "tsc -p tsconfig.build.json && cp src/data/docs-index.json dist/data/ && rm -rf dist/data/guides && cp -r ../../skills/lism-css-guide dist/data/guides",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepack": "case \"$npm_execpath\" in *pnpm*) ;; *) echo 'Error: Use pnpm publish' && exit 1;; esac"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
