{
  "name": "@lism-css/plugin",
  "version": "0.5.1",
  "description": "Build, Vite, Astro, and purge plugins for Lism CSS.",
  "author": {
    "name": "ddryo",
    "url": "https://github.com/ddryo"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "css-framework",
    "vite-plugin",
    "astro-integration"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "lint": "eslint '**/*.{js,mjs,ts}'",
    "prepack": "case \"$npm_execpath\" in *pnpm*) ;; *) echo 'Error: Use pnpm publish' && exit 1;; esac"
  },
  "bin": {
    "lism-css": "./bin/cli.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/builder/vite.d.ts",
      "import": "./dist/builder/vite.js"
    },
    "./astro": {
      "types": "./dist/builder/astro.d.ts",
      "import": "./dist/builder/astro.js"
    },
    "./next": {
      "types": "./dist/builder/next.d.ts",
      "import": "./dist/builder/next.js",
      "require": "./dist/builder/next.js"
    },
    "./webpack": {
      "types": "./dist/builder/webpack.d.ts",
      "import": "./dist/builder/webpack.js",
      "require": "./dist/builder/webpack.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js",
      "require": "./dist/builder/index.js"
    },
    "./purge/vite": {
      "types": "./dist/purge/vite.d.ts",
      "import": "./dist/purge/vite.js"
    },
    "./purge/astro": {
      "types": "./dist/purge/astro.d.ts",
      "import": "./dist/purge/astro.js"
    },
    "./bin/*": "./bin/*"
  },
  "homepage": "https://lism-css.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lism-css/core/tree/main/packages/plugin"
  },
  "bugs": {
    "url": "https://github.com/lism-css/core/issues"
  },
  "dependencies": {
    "autoprefixer": "^10.5.2",
    "cssnano": "^7.1.9",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "postcss": "^8.5.23",
    "sass": "^1.101.0"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0",
    "lism-css": "*",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "astro": "^7.3.2",
    "eslint": "^9.39.4",
    "lism-css": "workspace:*",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^7.3.6",
    "vite8": "npm:vite@^8.3.0",
    "vitest": "^4.1.11"
  },
  "sideEffects": false
}
