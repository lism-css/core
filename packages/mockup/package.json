{
  "name": "@lism-css/mockup",
  "version": "0.4.0",
  "description": "CLI for creating, validating, and previewing Lism CSS mockups. Bundled viewer + data-file contract (pages / tokens.json / mockup.config.json).",
  "author": {
    "name": "ddryo",
    "url": "https://github.com/ddryo"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "css-framework",
    "cli",
    "mockup",
    "preview"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/generate-lucide-types.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viewer/tsconfig.json",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'viewer/src/**/*.{ts,tsx}'",
    "prepack": "case \"$npm_execpath\" in *pnpm*) ;; *) echo 'Error: Use pnpm publish' && exit 1;; esac"
  },
  "bin": {
    "lism-mockup": "./bin/lism-mockup.mjs"
  },
  "files": [
    "dist",
    "bin",
    "viewer",
    "templates",
    "types"
  ],
  "type": "module",
  "homepage": "https://lism-css.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lism-css/core/tree/main/packages/mockup"
  },
  "bugs": {
    "url": "https://github.com/lism-css/core/issues"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@lism-css/plugin": "*",
    "@lism-css/ui": "*",
    "@vitejs/plugin-react": "^4.7.0",
    "commander": "^13.1.0",
    "lism-css": "*",
    "picocolors": "^1.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "tsx": "^4.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
