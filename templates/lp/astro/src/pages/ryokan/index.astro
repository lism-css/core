      path: 'M28.28,13.45c-2.42,0-4.77-0.76-6.75-2.16v9.8c0,4.9-4.01,8.91-8.91,8.91s-8.91-4.01-8.91-8.91s4.01-8.91,8.91-8.91c0.38,0,0.83,0,1.21,0.06v4.9c-2.16-0.7-4.45,0.51-5.09,2.67c-0.64,2.16,0.51,4.45,2.67,5.09c2.16,0.7,4.45-0.51,5.09-2.67c0.13-0.38,0.19-0.83,0.19-1.21V2h4.84c0,0.38,0,0.83,0.13,1.21l0,0c0.32,1.78,1.4,3.37,2.93,4.39c1.08,0.7,2.35,1.08,3.69,1.08C28.28,8.68,28.28,13.45,28.28,13.45z',
    },
    label: 'TikTok',
  },
  {
    href: '#',
    icon: {
      viewBox: '0 0 32 32',
      path: 'M13.6,25.58c1.7,0.38,1.51,1.01,1.13,3.28c-0.06,0.38-0.25,1.45,1.26,0.82c1.58-0.63,8.38-4.92,11.41-8.45 c2.08-2.33,3.09-4.67,3.09-7.25c0-6.56-6.56-11.85-14.5-11.85S1.5,7.42,1.5,13.98C1.5,19.78,6.67,24.63,13.6,25.58z M21.36,11.08 c0-0.13,0.13-0.25,0.25-0.25h4.1c0.13,0,0.25,0.13,0.25,0.25v1.01c0,0.13-0.13,0.25-0.25,0.25h-2.77v1.07h2.77 c0.13,0,0.25,0.13,0.25,0.25v1.07c0,0.13-0.13,0.25-0.25,0.25h-2.77V16h2.77c0.13,0,0.25,0.13,0.25,0.25v1.01 c0,0.13-0.13,0.25-0.25,0.25h-4.1c-0.13,0-0.25-0.13-0.25-0.25V11.08z M14.36,11.14c0-0.13,0.13-0.25,0.25-0.25h1.01 c0.06,0,0.19,0.06,0.25,0.13l2.9,3.91v-3.78c0-0.13,0.13-0.25,0.25-0.25h1.01c0.13,0,0.25,0.13,0.25,0.25v6.3 c0,0.13-0.13,0.25-0.25,0.25h-1.01c-0.06,0-0.19-0.06-0.25-0.13l-2.9-3.91v3.78c0,0.13-0.13,0.25-0.25,0.25h-1.01 c-0.13,0-0.25-0.13-0.25-0.25V11.14z M11.71,11.08c0-0.13,0.13-0.25,0.25-0.25h1.01c0.13,0,0.25,0.13,0.25,0.25v6.3 c0,0.13-0.13,0.25-0.25,0.25h-0.95c-0.13,0-0.25-0.13-0.25-0.25v-6.3H11.71z M6.23,11.08c0-0.13,0.13-0.25,0.25-0.25h1.01 c0.13,0,0.25,0.13,0.25,0.25v4.98h2.77c0.13,0,0.25,0.13,0.25,0.25v1.01c0,0.13-0.13,0.25-0.25,0.25H6.48 c-0.06,0-0.13-0.06-0.19-0.06c-0.06-0.06-0.06-0.13-0.06-0.19L6.23,11.08z',
    },
    label: 'LINE',
  },
];

const reservationBg = {
  src: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?auto=format&fit=max&w=1920&q=80',
  width: 1920,
  height: 1281,
};

type SiteCard = {
  title: string;
  body: string;
  href: string;
  image: { src: string; alt: string; width: number; height: number };
};

const reservationSites: readonly SiteCard[] = [
  {
    title: 'トラベルトリップ',
    body: '特典：早期予約で料金が割引になるキャンペーンを実施中です。空室カレンダーから日程を選べます。',
    href: '#',
    image: {
      src: 'https://images.unsplash.com/photo-1505440484611-23c171ad6e96?auto=format&fit=max&w=1920&q=80',
      alt: 'トラベルトリップのイメージ写真',
      width: 1920,
      height: 1304,
    },
  },
  {
    title: 'らくらく旅行予約',
    body: '特典：地域密着サポート付きプランをご用意しています。変更・キャンセルは各サイトの規定に従います。',
    href: '#',
    image: {
      src: 'https://images.unsplash.com/photo-1542640244-7e672d6cef4e?auto=format&fit=max&w=1920&q=80',
      alt: 'らくらく旅行予約のイメージ写真',
      width: 1920,
      height: 1281,
    },
  },
];
---

<Layout title={title}>
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400..700&display=swap" rel="stylesheet" slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500;600;700&display=swap" rel="stylesheet" slot="head" />
  <link href="https://fonts.googleapis.com/css2?family=Yuji+Syuku&display=swap" rel="stylesheet" slot="head" />
  <Container class="c--page">
    <Header />
    <!-- Main Content。各セクションは section 自身を container にし、内側の wrapper は container にしない（--bleed の 100cqi を gutter 込みの幅で解決するため。BP の基準もセクション幅） -->
    <Container as="main" class="c--main" pos="relative" z="0">
      <Container
        as="section"
        class="c--hero"
        pos="relative"
        ov="clip"
        bgc="base"
        style={{
          '--c--ryokan-mv-bgCycleDuration': `${mvBgCycleDuration}s`,
          '--c--ryokan-mv-lineBlurMax': `${mvLineRevealBlurPx}px`,
          '--c--ryokan-mv-lineDuration': `${mvLineRevealDuration}s`,
          '--c--ryokan-mv-lineStartDelay': `${mvLineRevealStartDelay}s`,
          '--c--ryokan-mv-lineStagger': `${mvLineRevealStagger}s`,
        }}
      >
        <Layer>
          {
            mvImages.map((src, index) => (
              <Layer
                class="c--hero_layer"
                bgi={`url('${src}')`}
                bgsz="cover"
                bgp="center"
                bgr="no-repeat"
                style={{
                  '--c--ryokan-mv-layerDelay': `${index * mvDurationPerImage - mvBgCycleDuration}s`,
                }}
              />
            ))
          }
        </Layer>
        <Layer bgc="black:30%" aria-hidden="true" />
        <Stack
          pos="relative"
          z="1"
          ai="center"
          jc="center"
          hasGutter
          pbs="calc(var(--header-h--init) + var(--s30))"
          pbe="40"
          min-h="min(100svh, 200vw)"
        >
          <Stack as="p" class="c--hero_copy" ff="accent" fz="clamp(1.5rem, 1.2857rem + 0.9524vw, 2rem)" wm="vertical-rl" lts="0.4em" lh="2.5">
            {
              mvCopyLines.map((line, i) => (
                <Inline class="c--hero_line" style={{ '--c--ryokan-mv-lineIndex': i }}>
                  {line}
                </Inline>
              ))
            }
          </Stack>
        </Stack>
      </Container>
      <!-- MV の動的 @keyframes はマージで抽出されないため、set:html で明示注入 -->
      <style set:html={mvLayeredKeyframesStyle}></style>

      <Container as="section" id="about" class="c--about" set="bleed" contentSize="l" py="60">
        <Grid gtc={['1fr', null, '1fr 50%']} g={['30', null, '0']} ai={['start', null, 'stretch']}>
          <Stack g={['40', null, null, '50']} h={['auto', null, '100%']}>
            <Stack g={['40', null, null, '50']} ps="var(--bleed)" pe={['var(--gutter--base)', null, '40', '50']}>
              <SectionHeading en="About us" ja="当宿について" ai="start" />
              <Text hl="l" c="text-2" ps={[null, null, null, '40']}>
                {aboutBodyCopy}
              </Text>
            </Stack>
            <Frame as="figure" set="bleed" contentSize="xl" ar="4/3" w="min(20rem, 100%)" ms="var(--bleed)" pbs="15" d={['none', null, 'block']}>
              <Media src={aboutImgLeft.src} alt={aboutImgLeft.alt} width={aboutImgLeft.width} height={aboutImgLeft.height} loading="lazy" />
            </Frame>
          </Stack>
          <!-- md 以上は行の高さいっぱいに敷くため aspect-ratio を外す -->
          <Frame as="figure" ar={['4/3', null, 'auto']} h={['auto', null, '100%']} min-h="0" pbe={['0', null, '50']}>
            <Media src={aboutImgRight.src} alt={aboutImgRight.alt} width={aboutImgRight.width} height={aboutImgRight.height} loading="lazy" />
          </Frame>
        </Grid>
      </Container>

      <Lism as="section" id="feature" class="c--feature" isContainer set="light" pos="relative" bgc="base" c="text" py="60">
        <Lism isWrapper="l" hasGutter set="bleed" pos="relative">
          <Grid gtc={['1fr', null, '1.05fr 1fr']} g={['40', null, null, '50']}>
            <Frame
              as="figure"
              class="c--feature_figure"
              pos="relative"
              aslf="stretch"
              order={[1, null, 0]}
              ar={['3/2', null, 'auto']}
              ms={[null, null, 'calc(-1 * var(--bleed))']}
              w={[null, null, 'calc(100% + var(--bleed))']}
              bdrs={['10', null, '0 var(--bdrs--10) var(--bdrs--10) 0']}
            >
              <Media
                src={featureImg.src}
                alt={featureImg.alt}
                width={featureImg.width}
                height={featureImg.height}
                loading="lazy"
                min-h={[null, null, 'min(22rem, 52vw, 540px)']}
              />
            </Frame>
            <Stack class="c--feature_textCol" pos="relative" min-h="0" h="100%">
              <Lism
                as="span"
                class="c--feature_watermark"
                aria-hidden="true"
                pos="absolute"
                z="0"
                i-bs="max(-0.75em, -50px)"
                i-s="-0.25em"
                ff="base"
                fz="clamp(3.25rem, -0.75rem + 8vw, 6.25rem)"
                fw="700"
                lts="0.025em"
                c="text:6%"
                whs="nowrap"
              >
                Experience
              </Lism>
              <!-- lg 以上は2列 grid: 見出しは右列上端、本文は左列下端 -->
              <Grid
                class="c--feature_copyRow"
                gtc={[null, null, null, '1fr auto']}
                gtr={[null, null, null, '1fr auto']}
                g={['50', null, '40']}
                min-h={['0', null, null, 'min(22rem, 52vw)']}
                pos="relative"
                fx="1"
              >
                <Heading
                  level="2"
                  class="c--feature_title"
                  fz={['2xl', null, '3xl']}
                  fw="bold"
                  lts="l"
                  aslf="start"
                  gc={[null, null, null, 2]}
                  gr={[null, null, null, '1/-1']}
                >
                  <Flex class="c--feature_titleInner" fxd={['column', null, null, 'row-reverse']} ai="start" g={['0', null, null, '20']}>
                    <Inline class="c--feature_titleLine1" wm={[null, null, null, 'vertical-rl']}>特別な旅と</Inline>
                    <Inline class="c--feature_titleLine2" ms="1em" wm={[null, null, null, 'vertical-rl']}>静寂の体験</Inline>
                  </Flex>
                </Heading>
                <Stack
                  g={['20', null, null, '30']}
                  ai="start"
                  gc={[null, null, null, 1]}
                  gr={[null, null, null, 2]}
                  max-w={[null, null, null, 'min(100%, 26rem)']}
                >
                  <Text fz={['l', null, 'xl']} fw="bold" lts="l">
                    {featureLead}
                  </Text>
                  <Text hl="l">
                    {featureBody}
                  </Text>
                </Stack>
              </Grid>
            </Stack>
          </Grid>
        </Lism>
      </Lism>

      <Lism as="section" id="feature2" class="c--season" isContainer pos="relative" ov-x="clip">
        <Frame isLayer>
          <Media src={seasonBg.src} alt="" width={seasonBg.width} height={seasonBg.height} loading="lazy" aria-hidden="true" />
        </Frame>
        <Layer bgc="black:75%" style={{ backdropFilter: 'blur(6px)' }} aria-hidden="true" />
        <Lism isWrapper="l" hasGutter pos="relative" z="1" pt="60">
          <Grid gtc={['1fr', null, 'min-content 1fr']} g={['40', null, '30', '50']} ai="start">
            <Stack g="25">
              <Heading level="2" fz={['3xl', null, null, '4xl']} lts="l" hl="l">
                <Inline whs="nowrap">季節の移ろいを、</Inline>肌で感じる。
              </Heading>
              <Inline class="b--enEyebrow" lang="en" o="pp" lts="l">Feeling the seasons</Inline>
            </Stack>
            <Text hl="xl" o="mp">
              {seasonIntroBody}
            </Text>
          </Grid>
        </Lism>
        <Lism isWrapper="xl" hasGutter pos="relative" z="1" pb="60">
          <Columns cols={[2, null, 4]} mbs="50" g={['15', null, null, '25']} ai="start">
            {
              seasonGalleryPhotos.map(({ src, alt, width, height }, i) => (
                <Frame as="figure" ar="4/3" pos="relative" mbs={i % 2 === 1 ? [null, null, '40'] : undefined}>
                  <Media src={src} alt={alt} width={width} height={height} loading="lazy" />
                </Frame>
              ))
            }
          </Columns>
        </Lism>
      </Lism>

      <Lism as="section" id="plans" class="c--plans" isContainer py="60">
        <Lism isWrapper="l" hasGutter>
          <Stack g="50">
            <SectionHeading en="Plan" ja="宿泊プラン" ai="center" ta="center" />

            {
              plans.map((plan) => (
                <Flex fxd={['column', null, 'row-reverse']} g={['30', null, '40', '50']}>
                  <Frame as="figure" ar="16/9" bdrs="10" w="100%" max-w={['100%', null, 'min(32rem, 40cqi)']}>
                    <Media src={plan.image.src} alt={plan.image.alt} width={plan.image.width} height={plan.image.height} loading="lazy" />
                  </Frame>

                  <Stack g="30" fx="1" min-h="0" jc="between">
                    <Stack g="30">
                      <Heading level="3" fz={['l', null, 'xl']} fw="500" lts="l">
                        {plan.title}
                      </Heading>
                      <Stack g="5">
                        <Text fz="xs" c="text-2" o="p">
                          {plan.roomType.label}
                        </Text>
                        <Text fw="bold" lts="l">
                          {plan.roomType.value}
                        </Text>
                      </Stack>
                      <Text fz="s" hl="l" c="text-2">
                        {plan.description}
                      </Text>
                    </Stack>

                    <Stack g="30" fxsh="0">
                      <Columns cols="2" bd bdrs="20" ov="hidden" bgc="base-2">
                        {plan.stats.map((stat, index) => (
                          <Stack g="10" px="20" py="25" ai="center" hl="s" ta="center" bd-s={index > 0 || undefined}>
                            <Text fz="xs" c="text-2" o="p">
                              {stat.label}
                            </Text>
                            <Text fw="bold" lts="l">
                              {stat.value}
                            </Text>
                          </Stack>
                        ))}
                      </Columns>

                      <Button href="#reservation" variant="outline" hov="-bgc" w="100%" bdrs="10" py="15" px="20" ta="center">
                        <Inline fw="500" lts="l">
                          このプランを予約する
                        </Inline>
                      </Button>
                    </Stack>
                  </Stack>
                </Flex>
              ))
            }
          </Stack>
        </Lism>
      </Lism>

      <Lism as="section" id="information" class="c--information" isContainer pos="relative" bgc="base-2" py="60" ov="hidden">
        <Lism isWrapper="l" hasGutter pos="relative" z="1">
          <Stack g="50">
            <Flex fxd={['column', null, 'row']} g={['30', null, '50']} ai={['start', null, 'end']} fxw="wrap">
              <SectionHeading en="Facilities" ja="館内設備" ai="start" fxsh="0" />
              <Text fz="s" hl="l" c="text-2" max-sz="s">
                {informationIntro}
              </Text>
            </Flex>

            <Columns cols={[1, null, 2]} g="30">
              {
                informationItems.map((item) => (
                  <Flex g={['20', null, '30']} ai="center" bd bdrs="20" ov="hidden" p={['20', null, '30']} bgc="base">
                    <Icon icon={item.icon} width="2.5em" height="2.5em" c="text-2" />
                    <Stack g="10" fx="1">
                      <Heading level="3" fz={['m', null, 'l']} fw="500" lts="l">
                        {item.title}
                      </Heading>
                      <Text fz="s" c="text-2">
                        {item.description}
                      </Text>
                    </Stack>
                  </Flex>
                ))
              }
            </Columns>
          </Stack>
        </Lism>
      </Lism>

      <Lism as="section" id="faq" class="c--faq" isContainer set="light" bgc="base" c="text" py="60">
        <Lism isWrapper="l" hasGutter layout="stack" g={['40', null, null, '50']}>
          <SectionHeading en="FAQ" ja="よくあるご質問" ai="center" ta="center" />
          <Accordion.Root layout="stack" bd-b>
            {
              faqItems.map((item) => (
                <Accordion.Item isOpen={item.defaultOpen === true} bd-t>
                  <Accordion.Heading>
                    <Accordion.Button g="15" py="25" isOpen={item.defaultOpen === true}>
                      {item.question}
                    </Accordion.Button>
                  </Accordion.Heading>
                  <Accordion.Panel pt="0" pb="25" isOpen={item.defaultOpen === true}>
                    <Text fz="s" c="text-2" hl="l">
                      {item.answer}
                    </Text>
                  </Accordion.Panel>
                </Accordion.Item>
              ))
            }
          </Accordion.Root>
        </Lism>
      </Lism>

      <Lism as="section" id="reservation" class="c--reservation" isContainer pos="relative" py="60" ov="hidden">
        <Frame isLayer>
          <Media src={reservationBg.src} alt="" width={reservationBg.width} height={reservationBg.height} loading="lazy" />
        </Frame>
        <Layer bgc="black:50%" style={{ backdropFilter: 'blur(6px)' }} aria-hidden="true" />

        <Lism isWrapper="l" hasGutter pos="relative" z="1">
          <Grid gtc={['1fr', null, null, '1.5fr 2fr']} g={['40', null, '50']}>
            <Stack g="30" ai="start">
              <SectionHeading en="Reservation" ja="ご予約はこちら" ai="start" />
              <Text fz="s" c="text-2">
                お好みの予約サイトからご予約いただけます。予約完了後は各サイトから確認メールが届きます。キャンセルや変更はご利用のサイトの案内に従ってお手続きください。
              </Text>
            </Stack>

            <Stack g="40">
              {
                reservationSites.map((site) => (
                  <Flex fxd={['column', 'row']} pos="relative" bgc="text" c="base" bdrs="20" ov="hidden">
                    <Frame as="figure" ar="16/9" w={['100%', '33.3%']} fxsh="0">
                      <Media src={site.image.src} alt={site.image.alt} width={site.image.width} height={site.image.height} loading="lazy" />
                    </Frame>
                    <Stack aslf="center" g="30" min-h="0" fx="1" px="25" py="30">
                      <Heading level="3" class="u--trim" fz="l">
                        {site.title}
                      </Heading>
                      <Text class="u--trim" fz="s" o="mp">
                        {site.body}
                      </Text>
                      <Button href={site.href} aslf="end" bgc="base" c="text" bdrs="10" py="15" px="20" fz="s" ta="center">
                        サイトに移動する
                      </Button>
                    </Stack>
                  </Flex>
                ))
              }
            </Stack>
          </Grid>
        </Lism>
      </Lism>
    </Container>
    <!-- Footer -->
    <Lism as="footer" id="footer" class="c--footer" isContainer py={['50', null, '60']}>
      <Lism isWrapper="xl" hasGutter>
        <Stack g={['40', null, '50']}>
          <Flex fxd={['column', null, null, 'row']} ai={['center', null, null, 'end']} g={['20', null, null, '40']}>
            <Heading level="2" fz="2xl" fw="normal" lts="l" hl="l" ff="accent">
              {logoLabel}
            </Heading>
            <Text fz="s" c="text-2">都会の喧騒から離れ、心安らぐ自然の中で、至福のひとときを。</Text>
          </Flex>

          <Flex fxd={['column', null, null, 'row']} ai="center" g="30">
            <NavMenu.Root layout="flex" fxd={['column', null, 'row']} jc={['center', null, null, 'start']} fxw="wrap" w="100%">
              {
                footerNavItems.map(({ href, ja, en }, index) => (
                  <NavMenu.Item bd bdw={[index < footerNavItems.length - 1 ? '0 0 1px 0' : '0', null, index > 0 ? '0 0 0 1px' : '0']}>
                    <NavMenu.Link
                      href={href}
                      layout="grid"
                      gtc={['1fr auto', null, '1fr']}
                      ji={['start', null, 'center']}
                      py={['15', null, '5']}
                      px={['5', null, '20']}
                      hov="-o"
                    >
                      <Stack class="c--footer_navStack" g="5">
                        <Inline>{ja}</Inline>
                        <Inline class="b--enEyebrow" lang="en" fz="xs" o="pp">
                          {en}
                        </Inline>
                      </Stack>
                      <Box d={['block', null, 'none']}>
                        <Icon icon={CaretRightIcon} weight="bold" fz="s" o="pp" />
                      </Box>
                    </NavMenu.Link>
                  </NavMenu.Item>
                ))
              }
            </NavMenu.Root>

            <Cluster g="15" jc={['center', null, 'end']} ai="end" fxsh="0">
              {
                footerSnsLinks.map(({ href, icon, label }) => (
                  <Link href={href} set="plain" p="5" o="p" hov={{ o: 1 }} hasTransition aria-label={label}>
                    <Icon viewBox={icon.viewBox} fill="currentColor" focusable="false" fz="xl">
                      <path d={icon.path} />
                    </Icon>
                  </Link>
                ))
              }
            </Cluster>
          </Flex>

          <Text fz="xs" o="pp" ta="center">© 2026 Lism CSS.</Text>
        </Stack>
      </Lism>
    </Lism>

    <Lism pos="fixed" z="99" r="max(var(--s35), env(safe-area-inset-right))" b="max(var(--s35), env(safe-area-inset-bottom))" w="fit">
