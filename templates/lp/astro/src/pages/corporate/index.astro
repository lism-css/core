  Center,
  Cluster,
  Container,
  Flex,
  Flow,
  Frame,
  Grid,
  Heading,
  Media,
  Icon,
  Inline,
  Layer,
  Link,
  Stack,
  Text,
} from 'lism-css/astro';
import { Accordion } from '@lism-css/ui/astro/Accordion';
import Header from '@/components/corporate/Header.astro';
import SectionHeading from '@/components/corporate/SectionHeading.astro';

// スタイル
import './_style.css';

// スクロール連動アニメーション（オフにしたい場合はこの行をコメントアウト）
