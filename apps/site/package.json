{
  "name": "lism-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:mdx": "tsx scripts/format-mdx-codeblocks.ts",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:astro": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro sync && tsc --noEmit && astro check --tsconfig ./tsconfig.json",
    "og:font": "tsx scripts/subset-og-font.ts",
    "generate:lastmod": "tsx scripts/generate-lastmod-map.ts",
    "screenshot:patterns:new": "pnpm build:astro && npx tsx scripts/generate-screenshots.ts",
    "screenshot:patterns:force": "pnpm build:astro && npx tsx scripts/generate-screenshots.ts --force",
    "screenshot:patterns:compare": "pnpm build:astro && npx tsx scripts/compare-screenshots.ts",
    "screenshot:patterns:update": "npx tsx scripts/update-screenshots.ts",
    "screenshot:templates": "npx tsx scripts/template-screenshots.ts",
    "screenshot:templates:force": "npx tsx scripts/template-screenshots.ts --force",
    "screenshot:templates:compare": "npx tsx scripts/template-screenshots.ts --compare",
    "screenshot:templates:update": "npx tsx scripts/template-screenshots.ts --update --no-build",
    "screenshot:layout-demos": "pnpm build:astro && npx tsx scripts/layout-demo-screenshots.ts",
    "screenshot:layout-demos:force": "pnpm build:astro && npx tsx scripts/layout-demo-screenshots.ts --force",
    "lint": "astro sync && pnpm lint:eslint",
    "lint:eslint": "eslint '**/*.{js,mjs,ts,tsx,astro,mdx}'",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@lism-css/icons": "*",
    "@lism-css/plugin": "workspace:*",
    "@lism-css/ui": "workspace:*",
    "@pagefind/default-ui": "^1.5.2",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "astro": "^7.3.2",
    "astro-expressive-code": "^0.44.2",
    "lism-css": "workspace:*",
    "lucide-react": "^0.577.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "satori": "^0.33.4",
    "satteri": "^0.10.5",
    "sharp": "^0.35.4",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "jsdom": "^27.4.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.0",
    "tsx": "^4.22.5",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11"
  }
}
