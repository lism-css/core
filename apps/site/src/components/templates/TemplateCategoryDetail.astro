---
/**
 * カテゴリページ本体（ja / en 共通）
 *
 * URL: /templates/{category}/  または  /{lang}/templates/{category}/
 * - 通常カテゴリ（Blog / LP 等）: テンプレートごとに h2 セクションを並べ、長い説明・機能・コマンド・リンクで比較できるようにする。
 * - aggregateView カテゴリ（Minimal 等）: 中身共通・stack 違いのみなので、コマンドを stack ごとに並べ、
 *   プレビューは representative slug の 1枚だけを表示する。
 */
import { Stack, Text, Group, Cluster, Inline, Frame, Flex, Columns, Heading, Link, BoxLink } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { Image } from 'astro:assets';
import { PreviewFrame, PreviewTitle } from '@/components/Preview';
import { getLocalizedUrl, type LangCode } from '@/lib/i18n';
import {
  stackLabels,
  stackOrder,
  getAggregateRepresentative,
  getThumb,
  getCategoryIntro,
  getPreviewUrl,
  type TemplateItem,
  type CategoryDef,
} from '@/config/templates';
import CopyCommand from './CopyCommand.astro';
import TemplateFeatures from './TemplateFeatures.astro';
import PageHeader from '@parts/PageHeader.astro';

interface Props {
  category: CategoryDef;
  templates: TemplateItem[];
  lang: LangCode;
}

const { category, templates, lang } = Astro.props as Props;
const isJa = lang === 'ja';

const copy = isJa
  ? {
      install: 'インストールコマンド',
      installCategoryLead: '対話形式で stack を選んで生成します。',
      installStackLead: 'stack を直接指定する場合：',
      commandLead: 'テンプレートをコピー:',
      details: '詳細を見る',
      viewDemo: 'デモページへ ↗',
      previewMissing: 'このテンプレートはまだプレビューURLが設定されていません。',
      copy: 'コマンドをコピー',
      copied: 'コピーしました',
      thumbAlt: (title: string) => `${title} のサムネイル`,
    }
  : {
      install: 'Install command',
      installCategoryLead: 'Pick a stack through the interactive flow.',
      installStackLead: 'Or specify a stack directly:',
      commandLead: 'Copy this template:',
      details: 'View details',
      viewDemo: 'View demo ↗',
      previewMissing: 'A preview URL is not configured for this template yet.',
      copy: 'Copy command',
      copied: 'Copied!',
      thumbAlt: (title: string) => `${title} thumbnail`,
    };

const templatesUrl = getLocalizedUrl('/templates/', lang);
const buildCommand = (slug: string) => `npm create lism@latest -- --template ${slug} --lang ${lang}`;
const buildDetailUrl = (slug: string) => getLocalizedUrl(`/templates/${category.id}/${slug}/`, lang);

// aggregateView 用
const stacks = stackOrder.filter((stack) => templates.some((tpl) => tpl.stack === stack));
const representative = getAggregateRepresentative(category, templates) ?? templates[0];
const representativePreviewUrl = representative ? getPreviewUrl(representative, lang) : undefined;
---

<Stack g="40">
  <PageHeader
    title={category.label}
    count={category.aggregateView ? undefined : templates.length}
    description={getCategoryIntro(category, lang)}
    lang={lang}
    breadcrumbs={[{ label: 'Templates', href: templatesUrl }, { label: isJa ? `${category.label}一覧` : category.label }]}
  />

  {
    category.aggregateView ? (
      <Fragment>
        <Cluster g="10">
          {stacks.map((stack) => (
            <Inline d="inline-flex" px="10" fz="2xs" ff="mono" c="text-2" bd bdc="current" bdrs="99">
              {stackLabels[stack]}
            </Inline>
          ))}
        </Cluster>

        <Group>
          <PreviewTitle>{copy.install}</PreviewTitle>
          <Stack g="20" p="20" bd bdrs="20" bgc="base">
            <Stack g="10">
              <Text util="trim" c="text-2" fz="xs" hl="s">
                {copy.installCategoryLead}
              </Text>
              <CopyCommand bdrs="10" command={buildCommand(category.id)} copyLabel={copy.copy} copiedLabel={copy.copied} />
            </Stack>
            <Stack g="10">
              <Text util="trim" c="text-2" fz="xs" hl="s">
                {copy.installStackLead}
              </Text>
              {templates.map((tpl) => (
                <CopyCommand bdrs="10" command={buildCommand(tpl.slug)} copyLabel={copy.copy} copiedLabel={copy.copied} />
              ))}
            </Stack>
          </Stack>
        </Group>

        <Group>
          {representativePreviewUrl ? (
            <PreviewFrame url={representativePreviewUrl} hasSizeSwitch externalButtonLabel={copy.viewDemo} />
          ) : representative ? (
            <Stack g="10">
              <Frame bd bdrs="20">
                <Image
                  src={getThumb(representative, lang)}
                  alt={copy.thumbAlt(category.label)}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 800px) 100vw, 800px"
                  loading="lazy"
                />
              </Frame>
              <Text c="text-2" fz="xs" hl="s" ta="center">
                {copy.previewMissing}
              </Text>
            </Stack>
          ) : null}
        </Group>
      </Fragment>
    ) : (
      <Stack g="40">
        {templates.map((tpl) => {
          const title = tpl.title[lang];
          const detailUrl = buildDetailUrl(tpl.slug);
          const previewUrl = getPreviewUrl(tpl, lang);
          const features = tpl.features?.[lang];
          const headingId = `${tpl.slug}-title`;
          return (
            <Stack as="section" id={tpl.slug} g="25" bd-t pt="40" aria-labelledby={headingId} class="c--templateSection">
              <Cluster ai="center" g="10">
                <Heading level="2" id={headingId} fz="xl">
                  <Link href={detailUrl} set="plain" hov="underline">
                    {title}
                  </Link>
                </Heading>
                <Inline d="inline-flex" px="10" fz="2xs" ff="mono" c="text-2" bd bdc="current" bdrs="99">
                  {stackLabels[tpl.stack]}
                </Inline>
                {tpl.draft && (
                  <Inline d="inline-flex" px="10" fz="2xs" ff="mono" bgc="text-2" c="base" bdrs="99">
                    draft
                  </Inline>
                )}
              </Cluster>

              <Columns cols="1" g="30" max-sz="m">
                <BoxLink layout="frame" href={detailUrl} aria-label={title} class="c--templateSection_thumbLink" ar="16/9" bd bdrs="20">
                  <Image src={getThumb(tpl, lang)} alt={copy.thumbAlt(title)} loading="lazy" />
                </BoxLink>
                <Stack g="30" p="5">
                  <Text util="trim">{tpl.description[lang]}</Text>
                  {features && features.length > 0 && <TemplateFeatures features={features} />}
                  <Stack g="15">
                    <Text util="trim" c="text-2" fz="s" hl="s">
                      {copy.commandLead}
                    </Text>
                    <CopyCommand bdrs="10" command={buildCommand(tpl.slug)} copyLabel={copy.copy} copiedLabel={copy.copied} />
                  </Stack>
                  <Flex g="15" fxw="wrap">
                    <Button href={detailUrl} bdrs="10" fz="m" px="20" hov="-bgc">
                      {copy.details}
                    </Button>
                    {previewUrl && (
                      <Button href={previewUrl} variant="outline" target="_blank" rel="noopener noreferrer" bdrs="10" fz="m" px="20" hov="-bgc">
                        {copy.viewDemo}
                      </Button>
                    )}
                  </Flex>
                </Stack>
              </Columns>
            </Stack>
          );
        })}
      </Stack>
    )
  }
</Stack>

<style>
  @layer lism-custom {
    .c--templateSection_thumbLink img {
      transition: transform 0.3s ease;
    }
    .c--templateSection_thumbLink:hover img {
      transform: scale(1.03);
    }
  }
</style>
