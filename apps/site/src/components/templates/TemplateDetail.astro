---
/**
 * テンプレート詳細ページ本体（ja / en 共通）
 *
 * URL: /templates/{category}/{slug}/  または  /{lang}/templates/{category}/{slug}/
 * カテゴリページ（TemplateCategoryDetail）から遷移して使う、テンプレート1件の紹介ページ。
 */
import { Stack, Text, Group, Cluster, Inline, Frame } from 'lism-css/astro';
import { Image } from 'astro:assets';
import { PreviewFrame, PreviewTitle } from '@/components/Preview';
import { getLocalizedUrl, type LangCode } from '@/lib/i18n';
import { stackLabels, getThumb, getIntro, getPreviewUrl, type TemplateItem, type CategoryDef } from '@/config/templates';
import CopyCommand from './CopyCommand.astro';
import TemplateFeatures from './TemplateFeatures.astro';
import PageHeader from '@parts/PageHeader.astro';

interface Props {
  template: TemplateItem;
  category: CategoryDef;
  lang: LangCode;
}

const { template, category, lang } = Astro.props as Props;
const isJa = lang === 'ja';

const copy = isJa
  ? {
      install: 'インストールコマンド',
      installLead: '対話なしで生成する場合：',
      viewDemo: 'デモページへ ↗',
      previewMissing: 'このテンプレートはまだプレビューURLが設定されていません。',
      copy: 'コマンドをコピー',
      copied: 'コピーしました',
      thumbAlt: (title: string) => `${title} のサムネイル`,
    }
  : {
      install: 'Install command',
      installLead: 'Skip the interactive flow:',
      viewDemo: 'View demo ↗',
      previewMissing: 'A preview URL is not configured for this template yet.',
      copy: 'Copy command',
      copied: 'Copied!',
      thumbAlt: (title: string) => `${title} thumbnail`,
    };

const categoryUrl = getLocalizedUrl(`/templates/${category.id}/`, lang);
const installCommand = `npm create lism@latest -- --template ${template.slug} --lang ${lang}`;
const previewUrl = getPreviewUrl(template, lang);
const features = template.features?.[lang];
---

<Stack g="40">
  <PageHeader
    title={template.title[lang]}
    description={getIntro(template, lang)}
    draft={template.draft}
    lang={lang}
    breadcrumbs={[
      { label: 'Templates', href: getLocalizedUrl('/templates/', lang) },
      { label: isJa ? `${category.label}一覧` : category.label, href: categoryUrl },
      { label: template.title[lang] },
    ]}
  >
    <Text slot="eyebrow" tt="uppercase" lts="l">
      {category.label}
    </Text>
  </PageHeader>

  <Cluster ai="center" g="10 15">
    <Inline d="inline-flex" px="10" fz="2xs" ff="mono" c="text-2" bd bdc="current" bdrs="99">
      {stackLabels[template.stack]}
    </Inline>
    {features && features.length > 0 && <TemplateFeatures features={features} />}
  </Cluster>

  <Group>
    <PreviewTitle>{copy.install}</PreviewTitle>
    <Stack g="10" p="20" bd bdrs="20" bgc="base">
      <Text util="trim" c="text-2" fz="xs" hl="s">{copy.installLead}</Text>
      <CopyCommand bdrs="10" command={installCommand} copyLabel={copy.copy} copiedLabel={copy.copied} />
    </Stack>
  </Group>

  <Group>
    {
      previewUrl ? (
        <PreviewFrame url={previewUrl} hasSizeSwitch externalButtonLabel={copy.viewDemo} />
      ) : (
        <Stack g="10">
          <Frame bd bdrs="20" w="100%">
            <Image src={getThumb(template, lang)} alt={copy.thumbAlt(template.title[lang])} loading="lazy" />
          </Frame>
          <Text c="text-2" fz="xs" hl="s" ta="center">
            {copy.previewMissing}
          </Text>
        </Stack>
      )
    }
  </Group>
</Stack>
