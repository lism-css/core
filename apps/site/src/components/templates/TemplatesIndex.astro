---
/**
 * Templates 一覧ページ本体（ja / en 共通）
 *
 * URL: /templates/  または  /{lang}/templates/
 * クイックスタートと、カテゴリごとの軽いカード（サムネ・タイトル・短い説明）だけを載せる。
 * 長い説明・機能比較・生成コマンドはカテゴリページ（TemplateCategoryDetail）に置く。
 */
import { Stack, AutoColumns, Text, Heading, Link, Frame, Lism, Inline } from 'lism-css/astro';
import { Image } from 'astro:assets';
import { getLocalizedUrl, type LangCode } from '@/lib/i18n';
import { groupByCategory, getAggregateRepresentative, getThumb } from '@/config/templates';
import { Preview, PreviewCode } from '@/components/Preview';
import SectionHeader from '@parts/SectionHeader.astro';
import PageHeader from '@parts/PageHeader.astro';

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;
const isJa = lang === 'ja';

const copy = isJa
  ? {
      title: 'Lism Templates',
      lead: 'Lism CSSでプロジェクトを始めるためのテンプレートをCLIコマンド1つで手元に生成できます。',
      quickStart: 'クイックスタート',
      quickStartLead: 'Lism CSSを組み込んだプロジェクト一式型のテンプレートを、コマンド一つでローカル環境にコピーできます。',
      available: 'テンプレートプレビュー',
      availableLead:
        'テンプレートはブログ・LP・最小構成といったプロジェクトの種類ごとにカテゴリ分けされており、同じカテゴリの中でもデザインや機能の異なるバリエーションから選べます。詳しい説明・機能の比較・生成コマンドは各カテゴリのページで確認できます。',
      commandLead: '対話形式でカテゴリ、スタック、バリアントを選んで生成します。',
      viewAll: 'すべて見る',
      thumbAlt: (title: string) => `${title} のサムネイル`,
    }
  : {
      title: 'Lism Templates',
      lead: 'Generate a Lism CSS project template locally with a single CLI command.',
      quickStart: 'Quick start',
      quickStartLead: 'Copy a full-project template with Lism CSS already set up to your local machine with a single command.',
      available: 'Template previews',
      availableLead:
        'Templates are grouped by project type, such as blog, landing page, and minimal setup, and each category offers several variants with different designs and features. See each category page for full descriptions, feature comparisons, and install commands.',
      commandLead: 'Start the interactive flow and choose category, stack, and variant in order.',
      viewAll: 'View all',
      thumbAlt: (title: string) => `${title} thumbnail`,
    };

const grouped = groupByCategory();

const buildDetailUrl = (category: string, slug: string) => getLocalizedUrl(`/templates/${category}/${slug}/`, lang);
const buildCategoryUrl = (category: string) => getLocalizedUrl(`/templates/${category}/`, lang);
---

<Stack g="50" data-pagefind-body>
  <PageHeader title={copy.title} description={copy.lead} />

  <Stack as="section" g="30">
    <Heading level="2">{copy.quickStart}</Heading>
    <Text hl="s">{copy.quickStartLead}</Text>
    <Preview>
      <PreviewCode slot="tab" label="npm">
        <Lism as="pre" class="c--templatesCode" p="15" bdrs="10" bgc="base-2" fz="xs" hl="s">
          <code>npm create lism@latest</code>
        </Lism>
      </PreviewCode>
      <PreviewCode slot="tab" label="pnpm">
        <Lism as="pre" class="c--templatesCode" p="15" bdrs="10" bgc="base-2" fz="xs" hl="s">
          <code>pnpm create lism</code>
        </Lism>
      </PreviewCode>
    </Preview>
    <Text util="trim" c="text-2" fz="s" hl="s">{copy.commandLead}</Text>
  </Stack>

  <Stack as="section" g="40" aria-labelledby="templates-list-title">
    <Stack g="30">
      <Heading id="templates-list-title" level="2">{copy.available}</Heading>
      <Text c="text-2" hl="s">{copy.availableLead}</Text>
    </Stack>

    {/* カテゴリ別グルーピング（見出しの「すべて見る」でカテゴリページへ） */}
    {
      grouped.map(({ category, items }) => {
        const categoryUrl = buildCategoryUrl(category.id);
        /* カード描画用データを正規化。aggregateView はカテゴリ 1 枚に集約し、リンク先もカテゴリページにする */
        const cards = category.aggregateView
          ? (() => {
              const rep = getAggregateRepresentative(category, items) ?? items[0];
              return [
                {
                  id: category.id,
                  title: category.label,
                  description: category.description[lang],
                  thumb: getThumb(rep, lang),
                  href: categoryUrl,
                  draft: false,
                },
              ];
            })()
          : items.map((tpl) => ({
              id: tpl.slug,
              title: tpl.title[lang],
              description: tpl.description[lang],
              thumb: getThumb(tpl, lang),
              href: buildDetailUrl(tpl.category, tpl.slug),
              draft: tpl.draft,
            }));

        return (
          <Stack g="30">
            <SectionHeader
              id={`templates-${category.id}`}
              level="3"
              title={category.label}
              count={items.length}
              href={categoryUrl}
              viewAllLabel={copy.viewAll}
            >
              <Text>{category.description[lang]}</Text>
            </SectionHeader>

            <AutoColumns cols="20em" g="15">
              {cards.map((card) => (
                <Stack as="article" id={card.id} g="0" bgc="base" ov="hidden" class="c--templatesCard">
                  <Frame isBoxLink as="a" href={card.href} class="c--templatesCard_thumbLink" aria-label={card.title} ar="16/9" bdrs="10" bd>
                    <Image src={card.thumb} alt={copy.thumbAlt(card.title)} loading="lazy" />
                  </Frame>
                  <Stack py="20" px="10" g="20" fxg="1">
                    <Heading level="4" fz="l" util="trim">
                      <Link href={card.href} set="plain" hov="underline">
                        {card.title}
                      </Link>
                      {card.draft && (
                        <Inline px="10" fz="2xs" bdrs="99" c="red">
                          draft
                        </Inline>
                      )}
                    </Heading>
                    <Text c="text-2" o="p" fz="s" util="trim">
                      {card.description}
                    </Text>
                  </Stack>
                </Stack>
              ))}
            </AutoColumns>
          </Stack>
        );
      })
    }
  </Stack>

  <style>
    @layer lism-custom {
      /* Quick start カード内のコードブロック */
      .c--templatesCode {
        max-width: 100%;
        overflow-x: auto;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .c--templatesCard_thumbLink img {
        transition: transform 0.3s ease;
      }
      .c--templatesCard_thumbLink:hover img {
        transform: scale(1.03);
      }
    }
  </style>
</Stack>
