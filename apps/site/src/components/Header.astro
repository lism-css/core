---
import { MenuIcon, SearchIcon } from '@lism-css/icons/astro';
import { Flex, Cluster, Container, Icon, Lism, Group, Link, Inline } from 'lism-css/astro';
import { Modal } from '@lism-css/ui/astro/Modal';
import { siteConfig } from '@/config/site';
import SearchModal from './SearchModal.astro';
import SiteNav from './SiteNav.astro';
import SNSLinks from './SNSLinks.astro';
// import LanguageSelect from './LanguageSelect.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { getLangFromUrl, getLocalizedUrl, t } from '@/lib/i18n';

interface Props {
  hasMobileMenu?: boolean;
  hasAllSns?: boolean; // false なら SNS リンクを GitHub のみにする（トップページ用）
}

const { hasMobileMenu = true, hasAllSns = true } = Astro.props;

// 現在の言語を取得
const currentLang = getLangFromUrl(Astro.url);
// サイトトップへのリンク（言語対応）
const homeUrl = getLocalizedUrl('/', currentLang);
// 翻訳テキスト
const searchText = t(currentLang, 'search');
const headerText = t(currentLang, 'header');
---

<Container as="header" class="c--siteHeader" layout="flex" ai="center">
  {/* 全体のgridレイアウトの切り替えと、ハンバーガーボタンの表示タイミングがずれないように hasGutterは内側につける */}
  <Flex ai="center" w="100%" mx="auto" p="20" class="b--shadowBox">
    <Group me="auto">
      <Link href={homeUrl} class="c--siteTitle" layout="flex" ai="center" g="5" fw="normal" c="inherit" td="none">
        <img class="u--onlyLightMode" src="/logo-black.svg" alt="" aria-labelledby="site-logo-label" width="300" height="62" />
        <img class="u--onlyDarkMode" src="/logo-white.svg" alt="" aria-labelledby="site-logo-label" width="300" height="62" />
        <span id="site-logo-label" class="u--srOnly" translate="no">{siteConfig.name}</span>
      </Link>
    </Group>

    {/* ms は c--docsLink / c--iconBtn の padding-inline 分を差し引いて、見た目の間隔を維持 */}
    <Link
      href="/docs/"
      class="c--docsLink"
      c="text"
      fw="500"
      lh="1.25"
      td="none"
      hov="-c"
      ms={{ base: 'calc(var(--s30) - var(--s15) / 2)', md: 'auto' }}>Docs</Link
    >

    {/* X・Discord はスマホ幅だと入りきらないので非表示（モバイルメニュー内には表示される） */}
    <SNSLinks
      icons={hasAllSns ? ['x', 'github', 'discord', 'lang'] : ['github', 'lang']}
      hideOnMobile={['x', 'discord']}
      d="flex"
      ms={{ base: 'calc(var(--s30) - var(--s15) / 2)', md: '30' }}
    />

    <!-- 検索トリガーボタン -->
    <Lism
      as="button"
      type="button"
      set="plain"
      class="c--searchTrigger"
      d="inline-flex"
      ai="center"
      px={{ base: '0', md: '.4rem' }}
      py={{ base: '0', md: '5' }}
      ms={{ base: '15', md: '20' }}
      g="5"
      bdrs="10"
      hov="-c"
      aria-label={searchText.title}
      data-modal-open="search-modal"
    >
      <Icon icon={SearchIcon} fz={{ base: '1.25rem', md: 'm' }} />
      <Lism
        as="kbd"
        class="c--searchTrigger_shortcut"
        set="plain"
        d={{ base: 'none', md: 'block' }}
        pe=".125rem"
        bxsh="none"
        fz=".95em"
        o="mp"
        ff="base"
        hl="xs"
        lts="s">⌘K</Lism
      >
    </Lism>

    <SearchModal />

    {/* ハンバーガーメニューボタン（モバイルのみ表示・hasMobileMenu が false なら出力しない） */}
    {
      hasMobileMenu && (
        <Modal.OpenBtn
          modalId="site-nav"
          class="c--menuTrigger l--center set--plain"
          d={['grid', null, 'none']}
          w="1.75rem"
          min-h="1.75rem"
          bdrs="10"
          ms="10"
          hov={{ bgc: 'base-2' }}
          aria-labelledby="menu-open-label"
        >
          {/* <Icon icon={MenuIcon} fz={['xl', null, 'l']} viewBox="0 0 256 256">
            <path d="M112,60a16,16,0,1,1,16,16A16,16,0,0,1,112,60Zm16,52a16,16,0,1,0,16,16A16,16,0,0,0,128,112Zm0,68a16,16,0,1,0,16,16A16,16,0,0,0,128,180Z" />
          </Icon> */}
          <Icon icon={MenuIcon} fz={['xl', null, 'l']} />
          <Inline d="none" id="menu-open-label">
            {headerText.openMenu}
          </Inline>
        </Modal.OpenBtn>
      )
    }
  </Flex>

  {/* モーダル（モバイルのみ表示・hasMobileMenu が false 出力しない） */}
  {
    hasMobileMenu && (
      <Modal.Root id="site-nav" isContainer isWrapper="s" py="40" px="30">
        <Modal.Inner class="c--siteNavModal_inner" layout="stack" g="0" w="100%" max-h="100%" pos="relative" py="20" pbs="30" bdrs="20" bgc="base">
          <Modal.CloseBtn modalId="site-nav" autofocus pos="absolute" t="0" r="0" z="1" fz="xl" p="10" m="15" bxsh="10" bdrs="10" bgc="base-2" />
          <Modal.Body class="c--siteNavModal_body" layout="stack" fx="1" min-h="0" px="30" pbs="40" pbe="0" ov-y="auto" z="0">
            <SiteNav />
          </Modal.Body>
          <Cluster class="c--siteNavModal_footer" g="10" fz="l" bd-t pbs="20" px="30">
            <SNSLinks />
            {/* <LanguageSelect /> */}
            <ThemeSwitch />
          </Cluster>
        </Modal.Inner>
      </Modal.Root>
    )
  }
</Container>
<style>
  /* logo */

  .c--siteTitle {
    font-family: var(--ff--mono);
  }
  .c--siteTitle > img {
    width: clamp(6rem, 15vw, 7.1875rem);
    height: auto;
  }

  /* Docs リンク：アイコンと同様に padding でホバー領域を連続させる */
  .c--docsLink {
    padding-inline: calc(var(--s15) / 2);

    @container (min-width: 800px) {
      & {
        padding-inline: calc(var(--s20) / 2);
      }
    }
  }

  /* 検索トリガーボタン */
  .c--searchTrigger {
    @container (min-width: 800px) {
      & {
        box-shadow: var(--bxsh--search-border);
        background: color-mix(in srgb, var(--base-2), transparent 60%);
      }
    }
  }

  /* ハンバーガーメニュー（site-nav モーダル） */
  :global(#site-nav.b--modal) .c--siteNavModal_inner {
    background-color: var(--base);
    box-shadow: var(--bxsh--base);
  }

  :global(#site-nav.b--modal) .c--siteNavModal_body {
    /* Modal.Body の flex 子としてスクロール可能にする */
    display: flex;
    flex-direction: column;
  }

  :global(#site-nav.b--modal) .c--siteNavModal_footer {
    flex-shrink: 0;
  }
</style>
