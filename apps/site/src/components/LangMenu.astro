---
/**
 * 言語切り替えメニュー
 * 現在のページの他言語バージョンへのリンクをドロップダウンで表示
 */
import { Icon, Lism, ListItem } from 'lism-css/astro';
import { getAlternateUrls, getLangFromUrl, getLangLabel, t } from '@/lib/i18n';
import { filterPatternAlternates } from '@/lib/patterns';

interface Props {
  [key: string]: unknown;
}

const currentLang = getLangFromUrl(Astro.url);
const alternateUrls = filterPatternAlternates(getAlternateUrls(Astro.url));
const langMenuText = t(currentLang, 'langMenu');

// ドロップダウン項目の共通プロップ
const langItemProps = {
  d: 'block',
  p: '0.25em',
  fz: 's',
  fw: '500',
  lh: '1.5',
  td: 'none',
  bdrs: 'calc(var(--bdrs--10) - 0.125em)',
} as const;
---

<Lism class="c--langMenu" pos="relative" {...Astro.props}>
  <Lism
    as="button"
    type="button"
    class="c--iconBtn c--langMenu_trigger"
    c="inherit"
    bd="none"
    bgc="transparent"
    title={langMenuText.ariaLabel}
    aria-expanded="false"
    aria-label={langMenuText.ariaLabel}
  >
    <Icon viewBox="0 0 20 20" fill="none">
      <g clip-path="url(#language-switcher-clip)">
        <path
          d="M1.66675 10C1.66675 14.6025 5.39758 18.3334 10.0001 18.3334C14.6026 18.3334 18.3334 14.6025 18.3334 10C18.3334 5.39752 14.6026 1.66669 10.0001 1.66669C5.39758 1.66669 1.66675 5.39752 1.66675 10Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
        <path
          d="M10.8333 1.70836C10.8333 1.70836 13.3333 5.00003 13.3333 10C13.3333 15 10.8333 18.2917 10.8333 18.2917M9.16665 18.2917C9.16665 18.2917 6.66665 15 6.66665 10C6.66665 5.00003 9.16665 1.70836 9.16665 1.70836M2.19165 12.9167H17.8083M2.19165 7.08336H17.8083"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </g>
      <defs>
        <clipPath id="language-switcher-clip">
          <rect width="20" height="20" fill="white"></rect>
        </clipPath>
      </defs>
    </Icon>
  </Lism>
  <Lism
    as="ul"
    class="c--langMenu_menu"
    pos="absolute"
    z="100"
    min-w="6rem"
    p="0.5em"
    bgc="base"
    bdrs="10"
    bxsh="30"
    aria-label={langMenuText.menuAriaLabel}
  >
    {
      alternateUrls.map(({ lang, url }) => (
        <ListItem>
          {lang === currentLang ? (
            <Lism as="span" class="c--langMenu_item -current" c="text-2" o="pp" aria-current="true" lang={lang} {...langItemProps}>
              {getLangLabel(lang)}
            </Lism>
          ) : (
            <Lism as="a" class="c--langMenu_item" c="inherit" hov="-c" href={url} lang={lang} hreflang={lang} {...langItemProps}>
              {getLangLabel(lang)}
            </Lism>
          )}
        </ListItem>
      ))
    }
  </Lism>
</Lism>

<style>
  /* ホバー領域を左右へ広げる量の基準（この半分ずつ広げる）。実際の間隔は配置側の ms で取るので、隣のアイコンとの間隔と同じ値にしておく */
  .c--langMenu {
    --langMenu-space: var(--s15);
  }
  @container (min-width: 800px) {
    .c--langMenu {
      --langMenu-space: var(--s20);
    }
  }

  .c--langMenu_trigger {
    border-radius: 0.25em;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    /* padding でホバー領域を広げ、同じ量の負の margin で、配置上はグリフの幅だけを占めるようにする */
    padding-inline: calc(var(--langMenu-space) / 2);
    margin-inline: calc(var(--langMenu-space) / -2);
  }
  .c--langMenu_trigger:hover {
    color: var(--link);
  }

  /* 言語切替ドロップダウン（配置・状態などプロップで表現できないもののみ記述） */
  .c--langMenu_menu {
    top: calc(100% + 0.5em);
    /* トリガーのホバー領域の右端に揃える */
    right: calc(var(--langMenu-space) / -2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25em);
    transition:
      opacity 0.15s,
      visibility 0.15s,
      transform 0.15s;
  }
  .c--langMenu[data-open] .c--langMenu_menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  /* PCではアイコン（グリフ左端）と左揃えで表示 */
  @container (min-width: 800px) {
    .c--langMenu_menu {
      right: auto;
      left: calc(-0.25em - var(--langMenu-space) / 2);
    }
  }

  .c--langMenu_item {
    transition: color 0.15s;
  }
  /* 現在の言語（グレーアウト自体は c="text-2" o="pp" プロップで指定） */
  .c--langMenu_item.-current {
    cursor: default;
  }

  /* モーダル内では下端で見切れないよう上方向に展開 */
  :global(.b--modal) .c--langMenu_menu {
    top: auto;
    bottom: calc(100% + 0.25em);
    transform: translateY(0.25em);
  }
  :global(.b--modal) .c--langMenu[data-open] .c--langMenu_menu {
    transform: translateY(0);
  }
</style>

<script>
  // 言語切替ドロップダウンのトグル動作
  document.querySelectorAll<HTMLElement>('.c--langMenu').forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>('.c--langMenu_trigger');
    const menuList = menu.querySelector('.c--langMenu_menu');
    if (!trigger || !menuList) return;

    const close = () => {
      const shouldRestoreFocus = menu.hasAttribute('data-open') && menuList.contains(document.activeElement);
      menu.removeAttribute('data-open');
      trigger.setAttribute('aria-expanded', 'false');
      if (shouldRestoreFocus) trigger.focus();
    };

    // クリックでメニュー開閉
    trigger.addEventListener('click', () => {
      if (menu.hasAttribute('data-open')) {
        close();
      } else {
        menu.setAttribute('data-open', '');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });

    // 外側クリックで閉じる
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) close();
    });

    // Escキーで閉じる
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Tab移動等でフォーカスがメニュー外へ出たら閉じる
    // （focusout時点ではactiveElementがメニュー内に残っていないため、close()のフォーカス復元は発動しない）
    menu.addEventListener('focusout', (e) => {
      if (!menu.contains(e.relatedTarget as Node)) close();
    });
  });
</script>
