---
import { Cluster, Icon } from 'lism-css/astro';
import { siteConfig } from '@/config/site';

type IconKey = 'x' | 'github' | 'discord';
interface Props {
  icons?: IconKey[];
  hideOnMobile?: IconKey[];
  [key: string]: unknown;
}
const { icons = ['x', 'github', 'discord'], hideOnMobile = [], ...props } = Astro.props;
const show = (key: IconKey) => icons.includes(key);

// SNSアイコンのクラス（hideOnMobile 指定分はスマホ幅で非表示）
const snsBtnClass = (key: IconKey) => ['c--iconBtn l--center -c:inherit', hideOnMobile.includes(key) && '-hideOnMobile'];
---

<Cluster class="c--snsLinks" jc="center" {...props}>
  {
    show('x') && (
      <a href={siteConfig.author.twitter} target="_blank" rel="noopener noreferrer" class:list={snsBtnClass('x')} title="Xへのリンク">
        <Icon viewBox="0 0 32 32" fill="currentColor" focusable="false">
          <path d="M18.42,13.99L27.88,3h-2.25l-8.21,9.57L10.86,3H3.3l9.93,14.48L3.3,29h2.25l8.69-10.1L21.14,29h7.56 L18.42,13.99L18.42,13.99z M15.35,17.6l-1-1.42L6.31,4.71h3.43l6.44,9.22l1,1.42l8.39,12h-3.43L15.35,17.6L15.35,17.6z" />
        </Icon>
      </a>
    )
  }
  {
    show('github') && (
      <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer" class:list={snsBtnClass('github')} title="GitHubへのリンク">
        <Icon viewBox="0 0 32 32" fill="currentColor" focusable="false">
          <path d="M15.73,2.32C7.93,2.32,2,8.25,2,16.05c0,6.17,3.93,11.55,9.49,13.43c0.67,0.12,0.97-0.3,0.97-0.67s0-2.3,0-3.39c0,0-3.93,0.85-4.72-1.63c0,0-0.6-1.63-1.57-2c0,0-1.27-0.91,0.06-0.91c0,0,1.39,0.12,2.18,1.45c1.21,2.18,3.27,1.51,4.11,1.21c0.12-0.91,0.48-1.51,0.91-1.87c-3.14-0.3-6.35-0.85-6.35-6.17c0-1.51,0.42-2.36,1.33-3.27c-0.12-0.36-0.6-1.87,0.12-3.81c1.21-0.36,3.87,1.51,3.87,1.51c1.15-0.3,2.36-0.48,3.57-0.48s2.42,0.18,3.57,0.48c0,0,2.72-1.87,3.87-1.51c0.79,1.94,0.3,3.39,0.12,3.81c0.91,1.03,1.45,1.75,1.45,3.27c0,5.44-3.27,5.81-6.47,6.17c0.48,0.42,0.97,1.27,0.97,2.6c0,1.87,0,4.23,0,4.66c0,0.36,0.24,0.85,0.97,0.73C26.19,27.78,30,22.4,30,16.17C29.82,8.25,23.47,2.32,15.73,2.32z" />
        </Icon>
      </a>
    )
  }
  {
    show('discord') && (
      <a href={siteConfig.author.discord} target="_blank" rel="noopener noreferrer" class:list={snsBtnClass('discord')} title="Discordへのリンク">
        <Icon viewBox="0 0 32 32" fill="currentColor" focusable="false">
          <path d="M26.07,6.66c-1.88-0.88-3.88-1.52-5.98-1.88c-0.26,0.47-0.56,1.09-0.77,1.59c-2.23-0.34-4.44-0.34-6.63,0 c-0.21-0.5-0.52-1.13-0.78-1.59c-2.1,0.36-4.11,1-5.99,1.88c-3.79,5.72-4.81,11.3-4.3,16.8c2.51,1.88,4.95,3.01,7.34,3.76 c0.59-0.81,1.12-1.68,1.57-2.59c-0.86-0.33-1.69-0.73-2.47-1.2c0.21-0.15,0.41-0.31,0.61-0.48c4.77,2.23,9.96,2.23,14.67,0 c0.2,0.17,0.4,0.33,0.61,0.48c-0.78,0.47-1.61,0.88-2.48,1.21c0.45,0.91,0.98,1.78,1.57,2.59c2.4-0.75,4.83-1.88,7.34-3.76 C30.98,17.09,29.35,11.56,26.07,6.66z M11.18,20.08c-1.43,0-2.61-1.34-2.61-2.97s1.15-2.97,2.61-2.97c1.46,0,2.63,1.34,2.61,2.97 C13.79,18.74,12.64,20.08,11.18,20.08z M20.82,20.08c-1.43,0-2.61-1.34-2.61-2.97s1.15-2.97,2.61-2.97c1.46,0,2.63,1.34,2.61,2.97 C23.42,18.74,22.27,20.08,20.82,20.08z" />
        </Icon>
      </a>
    )
  }
</Cluster>

<style>
  /* アイコン間の間隔（インラインstyleの --snsLinks-space 指定で上書き可能） */
  .c--snsLinks {
    --snsLinks-space: var(--s15);
    column-gap: var(--snsLinks-space);
  }
  @container (min-width: 800px) {
    .c--snsLinks {
      --snsLinks-space: var(--s20);
    }
  }

  .c--iconBtn {
    border-radius: 0.25em;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    /* gap の半分ずつ padding でホバー領域を広げてアイコン間の隙間をなくし、同じ量の負の margin で、配置上はグリフの幅だけを占めるようにする */
    padding-inline: calc(var(--snsLinks-space) / 2);
    margin-inline: calc(var(--snsLinks-space) / -2);
  }
  .c--iconBtn:hover {
    color: var(--link);
  }

  /* hideOnMobile 指定のアイコンはスマホ幅で非表示 */
  @container not (min-width: 800px) {
    .c--iconBtn.-hideOnMobile {
      display: none;
    }
  }
</style>
