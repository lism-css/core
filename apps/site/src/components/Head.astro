---
/**
 * 共通 <head> コンポーネント
 * - メタタグ、OGP、Twitter Card、Google Analytics などを管理
 * - BaseLayout と SimpleLayout で共通使用
 */

import { siteConfig } from '@/config/site';
import { getAlternateUrls, getRootLang, getLocalizedUrl, getPathWithoutLang } from '@/lib/i18n';
import { filterPatternAlternates } from '@/lib/patterns';
import type { LangCode } from '@/lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang: LangCode;
  noindex?: boolean; // ページ単位で noindex,follow を出力する（全体 publish フラグとは別軸）
}

const { title, description, ogImage, lang, noindex = false } = Astro.props;

const isDev = import.meta.env.DEV;

// canonical URL: 開発環境では現在のURLをそのまま使用、本番では Astro.site を使用
const canonicalUrl = isDev ? Astro.url.toString() : Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

// OG画像URL: 開発環境では相対パス、本番環境では絶対URL
const getOgImageUrl = (imgPath?: string): string | undefined => {
  if (!imgPath) return undefined;

  if (isDev) {
    return imgPath;
  }

  if (Astro.site) {
    return new URL(imgPath, Astro.site).toString();
  }

  return imgPath;
};

const ogImageUrl = getOgImageUrl(ogImage || '/ogimg-default.png');

const titleMetaText = title === siteConfig.name ? title : `${title} - ${siteConfig.name}`;

// 言語に応じた og:locale を生成
const ogLocaleMap: Record<LangCode, string> = {
  ja: 'ja_JP',
  en: 'en_US',
};
const ogLocale = ogLocaleMap[lang] || 'ja_JP';

// 多言語 hreflang 用の代替URL一覧
const alternateUrls = filterPatternAlternates(getAlternateUrls(Astro.url));
const rootLang = getRootLang();
const rootPath =
  alternateUrls.find(({ lang: code }) => code === rootLang)?.url ?? alternateUrls[0]?.url ?? getLocalizedUrl(getPathWithoutLang(Astro.url), rootLang);

// パスを絶対URLに変換（canonical と一致するよう末尾スラッシュを保証）
const toAbsoluteUrl = (path: string): string => {
  const normalized = path.endsWith('/') ? path : `${path}/`;
  if (isDev) return normalized;
  if (Astro.site) return new URL(normalized, Astro.site).toString();
  return normalized;
};

// Google Analytics: 本番環境のみ有効化
const enableGA = !isDev && siteConfig.publish;
---

<head>
  <meta charset="utf-8" />
  <script is:inline define:vars={{ defaultTheme: siteConfig.theme.default }}>
    // ちらつきを防ぐため、 head内でテーマセットする
    (function () {
      var stored = localStorage.getItem('theme');
      var mode = stored === 'light' || stored === 'dark' || stored === 'system' ? stored : defaultTheme;
      if (mode !== 'light' && mode !== 'dark' && mode !== 'system') mode = 'system';
      // system は常に OS 設定へ追従する（defaultTheme は未保存時のモード選択にだけ使う）
      var theme = mode === 'light' || mode === 'dark' ? mode : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.setAttribute('data-theme-mode', mode);
    })();
  </script>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    (function () {
      var viewport = document.querySelector('meta[name="viewport"]');
      if (!viewport) return;

      var defaultViewport = 'width=device-width, initial-scale=1';
      var minimumViewport = 'width=360';

      function updateViewport() {
        // viewport設定の影響を受けない画面幅で判定する
        var content = window.outerWidth < 360 ? minimumViewport : defaultViewport;
        if (viewport.getAttribute('content') !== content) {
          viewport.setAttribute('content', content);
        }
      }

      window.addEventListener('resize', updateViewport);
      updateViewport();
    })();
  </script>
  <meta name="generator" content={Astro.generator} />

  {/* 基本メタタグ */}
  <title>{titleMetaText}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonicalUrl} />
  {
    siteConfig.publish ? (
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    ) : (
      <meta name="robots" content="noindex, nofollow" />
    )
  }

  {/* 多言語 hreflang: 検索エンジンに各言語版の存在を通知 */}
  {alternateUrls.map(({ lang: altLang, url }) => <link rel="alternate" hreflang={altLang} href={toAbsoluteUrl(url)} />)}
  <link rel="alternate" hreflang="x-default" href={toAbsoluteUrl(rootPath)} />

  {/* OGP メタタグ */}
  <meta property="og:type" content="article" />
  <meta property="og:title" content={titleMetaText} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonicalUrl} />
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta property="og:site_name" content={siteConfig.name} />
  <meta property="og:locale" content={ogLocale} />
  {/* 他言語版の og:locale を通知 */}
  {
    alternateUrls
      .filter(({ lang: altLang }) => altLang !== lang)
      .map(({ lang: altLang }) => <meta property="og:locale:alternate" content={ogLocaleMap[altLang]} />)
  }

  {/* Twitter Card メタタグ */}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titleMetaText} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

  {/* Google Analytics: 条件レンダリング内の script は prettier-plugin-astro のパースバグを踏むため、define:vars で外に出す */}
  {enableGA && <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-NMXBW9GRL1" />}
  <script define:vars={{ enableGA }} is:inline>
    if (enableGA) {
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-NMXBW9GRL1');
    }
  </script>
  {/* Gen Interface JP（Inter + Noto Sans JP 合成）。ウェイトごとに別 @font-face なので all.css で全ウェイトを宣言し、woff2 は使用分だけ取得される */}
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link href="https://cdn.jsdelivr.net/npm/gen-interface-jp@0.8.0/cdn/all.css" rel="stylesheet" />

  {/* 追加のhead要素用スロット */}
  <slot />
</head>
