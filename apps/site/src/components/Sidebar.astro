---
import { Stack } from 'lism-css/astro';
import SiteNav from './SiteNav.astro';
---

{/* 中身はサイトナビだけなので aside（補足ランドマーク）にはしない。nav は SiteNav 側 */}
<Stack class="c--siteSidebar" isContainer g="10" {...Astro.props}>
  <Stack class="c--siteSidebar_nav" fx="1" min-h="0">
    <SiteNav />
  </Stack>
</Stack>

<script>
  // アクティブなナビリンクまでサイドバーをスクロール（instant: ページ読み込み時にアニメーションさせない）
  document
    .querySelector('.c--siteSidebar_nav :is(.c--navLink._active, [aria-current="page"])')
    ?.scrollIntoView({ block: 'center', behavior: 'instant' });
</script>
