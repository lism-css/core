---
/**
 * ドキュメント内の別ページへのカードリンク
 * コンテンツコレクションから title / description を取得して表示する
 * URL は現在の言語に自動変換される
 */
import { BoxLink, Flex, Icon, Stack } from 'lism-css/astro';
import { getPostWithFallback } from '@/lib/content';
import { getLangFromUrl, getLocalizedUrl } from '@/lib/i18n';

interface Props {
  // ドキュメント内ページのパス（例: '/docs/features', '/ui/Accordion'）
  path: string;
  // 手動でタイトルを上書きする場合
  title?: string;
  // 手動で説明文を上書きする場合
  description?: string;
}

const { path = '', title: manualTitle, description: manualDescription } = Astro.props;

// 現在の言語を取得
const currentLang = getLangFromUrl(Astro.url);

// path から hash を分離（記事検索には使わず、href にのみ付与）
const [pathWithoutHash, hash] = path.split('#');

// path → content collection の slug に変換
// 例: '/docs/features' → 'features', '/ui/Accordion' → 'ui/Accordion'
const slug = pathWithoutHash
  .replace(/^\/docs\//, '')
  .replace(/^\//, '')
  .replace(/\/$/, '');

// コンテンツコレクションから記事を取得（フォールバック対応）
const { entry } = await getPostWithFallback(currentLang, slug);

// 記事が見つからない場合の警告
if (!entry) {
  console.warn(`[DocsLink] 記事が見つかりません: ${slug} (path: ${path})`);
}

// 表示用データ（手動指定があればそちらを優先）
const displayTitle = manualTitle || entry?.data.title || path;
const displayDescription = manualDescription || entry?.data.description || '';

// リンク先URL（言語対応、hash を保持）
const href = getLocalizedUrl(pathWithoutHash, currentLang) + (hash ? `#${hash}` : '');
---

<BoxLink href={href} class="c--docsLink" layout="flex" ai="center" my="40" bd bdc="base-2" bxsh="10" hov="-bxsh -bdc" hasTransition set="hov">
  <Flex class="c--docsLink_icon" c="link" p="0.3125rem" hl="0" pos="absolute" t="15" l="15">
    <Icon viewBox="0 0 256 256" size="1.125rem">
      <path
        d="M232,48H160a40,40,0,0,0-32,16A40,40,0,0,0,96,48H24a8,8,0,0,0-8,8V200a8,8,0,0,0,8,8H96a24,24,0,0,1,24,24,8,8,0,0,0,16,0,24,24,0,0,1,24-24h72a8,8,0,0,0,8-8V56A8,8,0,0,0,232,48ZM96,192H32V64H96a24,24,0,0,1,24,24V200A39.81,39.81,0,0,0,96,192Zm128,0H160a39.81,39.81,0,0,0-24,8V88a24,24,0,0,1,24-24h64ZM160,88h40a8,8,0,0,1,0,16H160a8,8,0,0,1,0-16Zm48,40a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,128Zm0,32a8,8,0,0,1-8,8H160a8,8,0,0,1,0-16h40A8,8,0,0,1,208,160Z"
      ></path>
    </Icon>
  </Flex>

  <Stack class="c--docsLink_content" hl="s" g="5" fxg="1" py="15" pr="15" pl="3rem">
    <div class="c--docsLink_head -fw:500 -td:underline">{displayTitle}</div>
    {displayDescription && <p class="c--docsLink_description -c:text-2 -fz:s">{displayDescription}</p>}
  </Stack>
  <Icon
    class="c--docsLink_arrow"
    viewBox="0 0 24 24"
    size="1.5em"
    mx="10"
    hasTransition
    fill="none"
    o="mp"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="m9 18 6-6-6-6"></path>
  </Icon>
</BoxLink>

<style>
  .c--docsLink {
    border-radius: 5px;
    --hov-bdc: var(--link);
    --hov-bxsh: var(--bxsh--30);
    --transitionProps: box-shadow, border;
  }
  .c--docsLink_head {
    color: var(--link);
    line-height: 1.75;
  }
  .c--docsLink_description {
    line-height: 1.75;
  }
  .c--docsLink_arrow {
    --transitionProps: translate, color;
    translate: var(--_isHov, 3px 0);
    color: var(--_isHov, var(--link)) var(--_notHov, var(--divider));
  }
</style>
