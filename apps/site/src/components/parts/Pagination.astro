---
import { Flex, Lism } from 'lism-css/astro';
import { getRootLang, getLocalizedUrl, type LangCode } from '@/lib/i18n';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
  lang?: LangCode;
}

const { currentPage, totalPages, baseUrl = '/page/', lang = getRootLang() } = Astro.props;

function getPageUrl(page: number): string {
  if (page === 1) {
    return getLocalizedUrl('/', lang);
  }
  return getLocalizedUrl(`${baseUrl}${page}`, lang);
}

const range = 2;
const startPage = Math.max(1, currentPage - range);
const endPage = Math.min(totalPages, currentPage + range);

const pageNumbers: (number | 'ellipsis')[] = [];

if (startPage > 1) {
  pageNumbers.push(1);
  if (startPage > 2) {
    pageNumbers.push('ellipsis');
  }
}

for (let i = startPage; i <= endPage; i++) {
  pageNumbers.push(i);
}

if (endPage < totalPages) {
  if (endPage < totalPages - 1) {
    pageNumbers.push('ellipsis');
  }
  pageNumbers.push(totalPages);
}
---

{
  totalPages > 1 && (
    <nav class="c--pagination" aria-label="ページナビゲーション">
      <Flex g="10" jc="center" ai="center" fxw="wrap">
        {currentPage > 1 ? (
          <a href={getPageUrl(currentPage - 1)} class="c--pagination_arrow -prev" aria-label="前のページ">
            ←
          </a>
        ) : (
          <Lism as="span" class="c--pagination_arrow -prev -disabled" aria-hidden="true">
            ←
          </Lism>
        )}

        {pageNumbers.map((page) =>
          page === 'ellipsis' ? (
            <Lism as="span" class="c--pagination_ellipsis" aria-hidden="true">
              …
            </Lism>
          ) : page === currentPage ? (
            <Lism as="span" class="c--pagination_page -current" aria-current="page">
              {page}
            </Lism>
          ) : (
            <a href={getPageUrl(page)} class="c--pagination_page">
              {page}
            </a>
          )
        )}

        {currentPage < totalPages ? (
          <a href={getPageUrl(currentPage + 1)} class="c--pagination_arrow -next" aria-label="次のページ">
            →
          </a>
        ) : (
          <Lism as="span" class="c--pagination_arrow -next -disabled" aria-hidden="true">
            →
          </Lism>
        )}
      </Flex>
    </nav>
  )
}
