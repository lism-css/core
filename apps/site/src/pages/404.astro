---
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import { Stack, Flex, Lism, Icon, Heading, Link } from 'lism-css/astro';
---

<SimpleLayout title="404 - Page Not Found" excludeFromSearch centerMain>
  <Stack ai="center" g="40" ta="center">
    <Lism fz="5xl" fw="bold" ff="mono" c="text-2" hl="0">404</Lism>

    <Stack g="20" ai="center">
      <Heading level="1" fz="2xl"> ページが見つかりません </Heading>
      <Lism fz="m" c="text-2" max-w="40rem">
        お探しのページは存在しないか、移動した可能性があります。<br />
        URLが正しいかご確認ください。
      </Lism>
    </Stack>

    <Flex g="20" jc="center">
      <Link href="/docs/" layout="flex" ai="center" bdrs="99" g="10" py="15" px="20" bgc="text" c="base" td="none" hov="-bgc">
        <Icon hl="0" fz="l">📖</Icon>
        <span>Go to Docs</span>
      </Link>
    </Flex>
  </Stack>
</SimpleLayout>
