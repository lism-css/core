---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Box, Cluster, Container, Heading, Inline, Lism, Stack, Text } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="03 - Compare plans by feature">
  <Container as="section" isWrapper="l" hasGutter bgc="base" py="50">
    <Stack g="40">
      <Stack g="20" ai="center" ta="center">
        <Inline fz="s" c="text-2">Pricing plans</Inline>
        <Heading level="2" class="u--trim" fz="2xl" fw="bold"
          ><Inline d="inline-block">Compare plans</Inline>{' '}<Inline d="inline-block">by feature</Inline></Heading
        >
        <Text max-sz="s" c="text-2">Choose a plan that fits your team size and the support you need.</Text>
      </Stack>

      <Box ov-x="auto" pb="10" tabindex={0} role="region" aria-label="Pricing plan comparison. Scroll horizontally to view all plans.">
        <Lism as="table" w="100%" min-w="m" style={{ borderSpacing: 0 }}>
          <Lism as="caption" ta="start" fz="s" c="text-2" pbe="20">Compare monthly pricing and key features</Lism>
          <thead>
            <tr>
              <Lism as="th" scope="col" ta="start" p="20" bd-bs bd-be>Features</Lism>
              <Lism as="th" scope="col" ta="start" p="20" bd-bs bd-be>
                <Stack g="10">
                  <Inline fz="s" fw="bold">Starter</Inline>
                  <Cluster g="5" ai="end">
                    <Inline fz="3xl" fw="bold">0</Inline>
                    <Inline fz="xs" c="text-2">JPY/month</Inline>
                  </Cluster>
                </Stack>
              </Lism>
              <Lism as="th" scope="col" ta="start" p="20" bd-bs bd-be bgc="base-2">
                <Stack g="10">
                  <Inline w="fit" fz="xs" fw="bold" c="accent">Recommended</Inline>
                  <Inline fz="s" fw="bold">Standard</Inline>
                  <Cluster g="5" ai="end">
                    <Inline fz="3xl" fw="bold">2,980</Inline>
                    <Inline fz="xs" c="text-2">JPY/month</Inline>
                  </Cluster>
                </Stack>
              </Lism>
              <Lism as="th" scope="col" ta="start" p="20" bd-bs bd-be>
                <Stack g="10">
                  <Inline fz="s" fw="bold">Business</Inline>
                  <Cluster g="5" ai="end">
                    <Inline fz="3xl" fw="bold">8,980</Inline>
                    <Inline fz="xs" c="text-2">JPY/month</Inline>
                  </Cluster>
                </Stack>
              </Lism>
            </tr>
          </thead>
          <tbody>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Members</Lism>
              <Lism as="td" p="20" bd-be>1 member</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">Up to 10 members</Lism>
              <Lism as="td" p="20" bd-be>Unlimited</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Projects</Lism>
              <Lism as="td" p="20" bd-be>3</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">50</Lism>
              <Lism as="td" p="20" bd-be>Unlimited</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Storage</Lism>
              <Lism as="td" p="20" bd-be>2GB</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">100GB</Lism>
              <Lism as="td" p="20" bd-be>1TB</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Version history</Lism>
              <Lism as="td" p="20" bd-be>7 days</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">1 year</Lism>
              <Lism as="td" p="20" bd-be>Unlimited</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Chat support</Lism>
              <Lism as="td" p="20" bd-be>—</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">Included</Lism>
              <Lism as="td" p="20" bd-be>Priority support</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20" bd-be>Activity logs</Lism>
              <Lism as="td" p="20" bd-be>—</Lism>
              <Lism as="td" p="20" bd-be bgc="base-2" fw="bold">Included</Lism>
              <Lism as="td" p="20" bd-be>Detailed logs</Lism>
            </tr>
            <tr>
              <Lism as="th" scope="row" ta="start" p="20">Sign up</Lism>
              <Lism as="td" p="20"><Button href="#" variant="outline" jc="center" w="100%" py="15" bdrs="10">Get started free</Button></Lism>
              <Lism as="td" p="20" bgc="base-2"><Button href="#" jc="center" w="100%" py="15" bdrs="10">Choose this plan</Button></Lism>
              <Lism as="td" p="20"><Button href="#" variant="outline" jc="center" w="100%" py="15" bdrs="10">Choose this plan</Button></Lism>
            </tr>
          </tbody>
        </Lism>
      </Box>
    </Stack>
  </Container>
</DemoLayout>
