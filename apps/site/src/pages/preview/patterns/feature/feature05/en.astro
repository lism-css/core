<DemoLayout title="Feature05">
  <Container as="section" aria-label="Web design studio services" isWrapper="l" hasGutter bgc="base" c="text" py="40">
    <Columns cols={[1, null, 2]} ai="stretch" bd bdc="divider" g="1px" bgc="divider">
      <Frame d="grid" ar={[null, null, '2/1']} w="100%" bgc="base" p={['30', '35', '40']} pos="relative">
        <Media
          isLayer
          src="https://images.unsplash.com/photo-1669295384050-a1d4357bd1d7?auto=format&fit=max&w=1920&q=80"
          alt=""
          width="1254"
          height="1254"
          loading="lazy"
        />
        <Layer bgc="black:50%" />
        <Heading class="u--trim" pos="relative" c="white" fz={['l', 'xl']} lts="l" fw="normal" my="auto" py="20">What We Can Do</Heading>
      </Frame>
      {
        features.map((feature) => (
          <Stack as="article" ar={[null, null, '2/1']} w="100%" bgc="base" p={['30', '35', '40']} g="30">
            <Center p=".25em" fz={['xl', '2xl']} w="fit-content" ar="1/1" bd bdrs="20">
              <Icon viewBox="0 0 24 24" set:html={feature.icon} />
            </Center>
            <Stack g="15" mbs="auto">
              <Heading level="3" fz={['m', 'l']}>
                {feature.title}
              </Heading>
              <Text fz="s" c="text-2">
                {feature.description}
              </Text>
            </Stack>
          </Stack>
        ))
      }
    </Columns>
  </Container>
</DemoLayout>
