---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Layer, Media, Text, Heading } from 'lism-css/astro';
---

<DemoLayout title="General07">
  <Container>
    <Stack>
      <Frame as="figure" ar="16/9" pos="relative" max-h="32rem">
        <Media src="https://cdn.lism-css.com/img/kpwuzP15GeSP.webp" alt="" width="960" height="640" />
        <Layer bgc="black:25%">
          <Container isWrapper="m" py="40" h="100%" hasGutter>
            <Stack jc="flex-end" g="30" min-h="100%" c="white">
              <Heading level="2" class="u--trim" fz="min(5vw, 2rem)" fw="bold">Walk Through the Light</Heading>
              <Text class="u--trim" fz="min(2.5vw, 1rem)">Walk through the light</Text>
            </Stack>
          </Container>
        </Layer>
      </Frame>
      <Container isWrapper="m" py="40" hasGutter>
        <Stack g="30">
          <Heading level="3" fz="xl" fw="bold">An Immersive Exhibition of Light and Shadow</Heading>
          <Text>
            A single line of light moves quietly through the darkened gallery. Its color and brightness shift slowly over time, so you will never see
            the same scene twice.
          </Text>
          <Text>
            This exhibition presents light installations by six artists from Japan and abroad. Walk among the works and feel the spaces created by
            light and shadow with your whole body.
          </Text>
          <Text>
            The venue consists of five dimly lit rooms, and each work has its own colors of light and sound. There is no set route, so feel free to
            stop in front of any work that catches your eye and stay as long as you like.
          </Text>
          <Text>On Fridays and Saturdays, the museum stays open until 8 p.m.</Text>
        </Stack>
      </Container>
    </Stack>
  </Container>
</DemoLayout>
