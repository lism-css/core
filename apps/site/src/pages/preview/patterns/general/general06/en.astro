---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Layer, Media, Text, Heading } from 'lism-css/astro';
---

<DemoLayout title="General06">
  <Container>
    <Stack>
      <Frame as="figure" ar="16/9" pos="relative" max-h="32rem">
        <Media src="https://cdn.lism-css.com/img/BObC4emORTNt.webp" alt="" width="960" height="640" />
        <Layer bgc="black:25%">
          <Container isWrapper="m" py="40" h="100%" hasGutter>
            <Stack jc="flex-end" g="30" min-h="100%" c="white">
              <Heading level="2" class="u--trim" fz="min(5vw, 2rem)" fw="bold">Inspiration at Your Fingertips</Heading>
              <Text class="u--trim" fz="min(2.5vw, 1rem)">Inspiration at your fingertips</Text>
            </Stack>
          </Container>
        </Layer>
      </Frame>
      <Container isWrapper="m" py="40" hasGutter>
        <Stack g="30">
          <Heading level="3" fz="xl" fw="bold">New Discoveries in Your Own Town</Heading>
          <Text>
            There are wonderful places and stories hidden in your city that you have yet to discover. Our service carefully delivers locally rooted
            information, from hidden cafes known only to locals to small weekend events.
          </Text>
          <Text>
            Save the shops and events that catch your eye to build a map of your own. Seasonal features and recommended walking routes are updated a
            little every week. On your next day off, why not take a small detour?
          </Text>
          <Text>Your usual way home transforms into a road full of new discoveries. Let's start that experience together.</Text>
        </Stack>
      </Container>
    </Stack>
  </Container>
</DemoLayout>
