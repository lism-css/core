---
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Wrapper, Flex, Frame, Media, Stack, Text } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="General01">
  <Wrapper contentSize="s" py="50" bgc="base" hasGutter>
    <Stack ai="center" g="40">
      <h2 class="u--trim">Enriching Everyday Life</h2>
      <Frame as="figure" ar="16/9" pos="relative" bdrs="20" bxsh="30">
        <Media src="https://images.unsplash.com/photo-1584412182057-c4c8a22ff533?auto=format&fit=max&w=1920&q=80" alt="" width="960" height="640" />
      </Frame>
      <Text class="u--trim" fz="m">
        Lawns and shaded walking paths in the heart of the city. We are creating neighborhoods where you can enjoy greenery right next to your office
        or home. From a short break at lunchtime to a weekend picnic, we build places that make everyday life a little richer.
      </Text>
      <Flex g="30" ai="center" jc="center">
        <Button href="#" min-w="250px" py="15" bdrs="10">View More</Button>
      </Flex>
    </Stack>
  </Wrapper>
</DemoLayout>
