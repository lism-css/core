---
import { ArrowRightIcon } from '@lism-css/icons/astro';
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Columns, Grid, Media, Flex, Icon, Layer, Center, Text, Inline } from 'lism-css/astro';
---

<DemoLayout title="PageLinks02">
  <Container isWrapper="l" py="50" hasGutter>
    <Stack g="40">
      <Grid gtc={['1fr', null, 'auto 1fr']} g="inherit">
        <Stack class="u--trimAll" g="20">
          <h2>私たちの技術領域</h2>
          <Text fz="l" ff="accent" o="pp">Our expertise</Text>
        </Stack>
        <Flex class="u--trimAll" jc={['s', null, 'end']}>
          <Text max-w="32rem" fz="s" o="p">
            最新のテクノロジーで、企業の課題解決と新たな価値づくりを支援します。 AIからデータ活用まで、事業に合わせて最適な形でご提供します。
          </Text>
        </Flex>
      </Grid>
      <Columns cols={[2, null, 4]} g={['30', '40']}>
        <Grid as="a" isBoxLink href="#" g="20" ai="start" set="hov">
          <Frame as="figure" ar="1/1" bdrs="10" pos="relative">
            <Media
              src="https://images.unsplash.com/photo-1742783201678-33840ee6ee0b?auto=format&fit=max&w=1920&q=80"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer hasTransition hov="in:show" bgc="rgb(0 0 0 / 30%)" style={{ backdropFilter: 'blur(4px)' }}>
              <Center h="100%" c="white">
                <Inline fz="xl" fs="italic" fw="light" lts="l" px="20" py="10">View More</Inline>
              </Center>
            </Layer>
          </Frame>
          <Flex ai="center" jc="flex-start" g="15" fz="m" hl="s">
            <Inline>AI・機械学習の活用</Inline>
            <Icon icon={ArrowRightIcon} weight="bold" ms="auto" hasTransition hov="in:solid" />
          </Flex>
        </Grid>
        <Grid as="a" isBoxLink href="#" g="20" ai="start" set="hov">
          <Frame as="figure" ar="1/1" bdrs="10" pos="relative">
            <Media
              src="https://images.unsplash.com/photo-1622547748225-3fc4abd2cca0?auto=format&fit=max&w=1920&q=80"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer hasTransition hov="in:show" bgc="rgb(0 0 0 / 30%)" style={{ backdropFilter: 'blur(4px)' }}>
              <Center h="100%" c="white">
                <Inline fz="xl" fs="italic" fw="light" lts="l" px="20" py="10">View More</Inline>
              </Center>
            </Layer>
          </Frame>
          <Flex ai="center" jc="flex-start" g="15" fz="m" hl="s">
            <Inline>クラウド基盤の構築</Inline>
            <Icon icon={ArrowRightIcon} weight="bold" ms="auto" hasTransition hov="in:solid" />
          </Flex>
        </Grid>
        <Grid as="a" isBoxLink href="#" g="20" ai="start" set="hov">
          <Frame as="figure" ar="1/1" bdrs="10" pos="relative">
            <Media
              src="https://images.unsplash.com/photo-1618005198919-d3d4b5a92ead?auto=format&fit=max&w=1920&q=80"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer hasTransition hov="in:show" bgc="rgb(0 0 0 / 30%)" style={{ backdropFilter: 'blur(4px)' }}>
              <Center h="100%" c="white">
                <Inline fz="xl" fs="italic" fw="light" lts="l" px="20" py="10">View More</Inline>
              </Center>
            </Layer>
          </Frame>
          <Flex ai="center" jc="flex-start" g="15" fz="m" hl="s">
            <Inline>セキュリティ対策</Inline>
            <Icon icon={ArrowRightIcon} weight="bold" ms="auto" hasTransition hov="in:solid" />
          </Flex>
        </Grid>
        <Grid as="a" isBoxLink href="#" g="20" ai="start" set="hov">
          <Frame as="figure" ar="1/1" bdrs="10" pos="relative">
            <Media
              src="https://images.unsplash.com/photo-1684670179697-7b6d0213f152?auto=format&fit=max&w=1920&q=80"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer hasTransition hov="in:show" bgc="rgb(0 0 0 / 30%)" style={{ backdropFilter: 'blur(4px)' }}>
              <Center h="100%" c="white">
                <Inline fz="xl" fs="italic" fw="light" lts="l" px="20" py="10">View More</Inline>
              </Center>
            </Layer>
          </Frame>
          <Flex ai="center" jc="flex-start" g="15" fz="m" hl="s">
            <Inline>データ分析・活用</Inline>
            <Icon icon={ArrowRightIcon} weight="bold" ms="auto" hasTransition hov="in:solid" />
          </Flex>
        </Grid>
      </Columns>
    </Stack>
  </Container>
</DemoLayout>

<style>
  @media (any-hover: hover) {
    .-hov\:in\:zoom {
      scale: var(--_isHov, 1.1);
    }
    .-hov\:in\:solid {
      opacity: var(--_notHov, var(--o--ppp));
    }
  }
</style>
