---
import { ArrowRightIcon } from '@lism-css/icons/astro';
import DemoLayout from '@/layouts/DemoLayout.astro';

import { Stack, Container, Frame, Grid, Columns, Media, Flex, Icon, Layer, Text, Heading } from 'lism-css/astro';
---

<DemoLayout title="PageLinks03">
  <Container isWrapper="l" py="50" hasGutter>
    <Stack g="50">
      <Heading class="u--trim" level="2" fz="2xl" ta="center">Craftsmanship That Fits Your Life</Heading>
      <Columns cols={[1, null, 3]} g="30" rg="40">
        <Stack g="20">
          <Frame as="a" isBoxLink href="#" pos="relative" ar={['1/1', null, '3/4']} bdrs="10" bxsh="30" td="none" set="hov">
            <Media
              isLayer
              src="https://images.unsplash.com/photo-1760325902589-fe244f204b08?auto=format&fit=max&w=1920&q=80"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer bgc="rgb(0 0 0 / 20%)" />
            <Stack pos="relative" h="100%" jc="flex-end" c="white" p="30" g="20" mbs="auto">
              <Grid gtc="1fr auto" ai="end" g="30">
                <Stack g="20" class="u--trimAll">
                  <Text fz="l" fw="bold" hl="s">Solid Wood Furniture</Text>
                  <Text fz="s" hl="s" o="p">Solid Wood</Text>
                </Stack>
                <Flex ai="center" jc="center" bd bdc="white" p="15" bdrs="99" c="white" hasTransition hov="in:reverse">
                  <Icon icon={ArrowRightIcon} weight="bold" fz="s" />
                </Flex>
              </Grid>
            </Stack>
          </Frame>
          <Text fz="s">Made from domestic solid wood, our furniture gains character the longer you use it.</Text>
        </Stack>
        <Stack g="20">
          <Frame as="a" isBoxLink href="#" pos="relative" ar={['1/1', null, '3/4']} bdrs="10" bxsh="30" td="none" set="hov">
            <Media
              isLayer
              src="https://images.pexels.com/photos/11676700/pexels-photo-11676700.jpeg?auto=compress&cs=tinysrgb&w=1000"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer bgc="rgb(0 0 0 / 20%)" />
            <Stack pos="relative" h="100%" jc="flex-end" c="white" p="30" g="20" mbs="auto">
              <Grid gtc="1fr auto" ai="end" g="30">
                <Stack g="20" class="u--trimAll">
                  <Text fz="l" fw="bold" hl="s">Skilled Craftsmanship</Text>
                  <Text fz="s" hl="s" o="p">Handcrafted</Text>
                </Stack>
                <Flex ai="center" jc="center" bd bdc="white" p="15" bdrs="99" c="white" hasTransition hov="in:reverse">
                  <Icon icon={ArrowRightIcon} weight="bold" fz="s" />
                </Flex>
              </Grid>
            </Stack>
          </Frame>
          <Text fz="s">From selecting the timber to the final finish, skilled artisans craft each piece by hand.</Text>
        </Stack>
        <Stack g="20">
          <Frame as="a" isBoxLink href="#" pos="relative" ar={['1/1', null, '3/4']} bdrs="10" bxsh="30" td="none" set="hov">
            <Media
              isLayer
              src="https://images.pexels.com/photos/7219173/pexels-photo-7219173.jpeg?auto=compress&cs=tinysrgb&w=1000"
              alt=""
              width="960"
              height="640"
              hasTransition
              hov="in:zoom"
            />
            <Layer bgc="rgb(0 0 0 / 20%)" />
            <Stack pos="relative" h="100%" jc="flex-end" c="white" p="30" g="20" mbs="auto">
              <Grid gtc="1fr auto" ai="end" g="30">
                <Stack g="20" class="u--trimAll">
                  <Text fz="l" fw="bold" hl="s">Designed to Last</Text>
                  <Text fz="s" hl="s" o="p">Built to Last</Text>
                </Stack>
                <Flex ai="center" jc="center" bd bdc="white" p="15" bdrs="99" c="white" hasTransition hov="in:reverse">
                  <Icon icon={ArrowRightIcon} weight="bold" fz="s" />
                </Flex>
              </Grid>
            </Stack>
          </Frame>
          <Text fz="s">With repair and reupholstery available, each piece can be used for generations.</Text>
        </Stack>
      </Columns>
    </Stack>
  </Container>
</DemoLayout>

<style>
  @media (any-hover: hover) {
    .-hov\:in\:zoom {
      scale: var(--_isHov, 1.1);
    }
    .-hov\:in\:reverse {
      background-color: var(--_isHov, var(--white));
      color: var(--_isHov, var(--black));
    }
  }
</style>
