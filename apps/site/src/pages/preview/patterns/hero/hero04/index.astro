---
import { Menu2Icon } from '@lism-css/icons/astro';
import DemoLayout from '@/layouts/DemoLayout.astro';
import { Container, Grid, Columns, Frame, Media, Stack, Flex, Cluster, Heading, Text, Icon, Link } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
---

<DemoLayout title="Hero04">
  <Container as="header" isWrapper="xl" hasGutter pos="fixed" t="0" l="0" z="99" w="100%">
    <Flex ai="center" jc="start" g="30" py="15">
      <Button as="button" type="button" aria-label="メニュー" bgc="transparent" c="text" bd="none" p="10" bgc="base" bdrs="99">
        <Icon icon={Menu2Icon} weight="light" fz="2xl" />
      </Button>
      <Link href="#" set="plain" fz="xl" lts="l">LISM</Link>
    </Flex>
  </Container>
  <Grid as="section" class="c--hero04" isContainer bgc="base" c="text">
    <Frame ga={['auto', null, '1/1']} ms={['0', null, '50%']} ar={['1/1', null, 'auto']} style={{ contain: 'size' }}>
      <Media src="https://images.unsplash.com/photo-1761782797823-2b555af8a226?auto=format&fit=max&w=1000&q=80" alt="" width="1920" height="1076" />
    </Frame>
    <Columns hasGutter ga={['auto', null, '1/1']} cols={[1, null, 2]} max-sz="xl" w="100%" mx="auto" min-h={['auto', null, '100svh']}>
      <Stack pe={{ md: 'var(--gutter)' }} pt="40" pb="var(--gutter)">
        <Stack py={['50', null, '20']} g="35" my="auto">
          <Heading level="1" my="auto" fz="clamp(var(--fz--2xl), 4cqi, var(--fz--3xl))" fw="800" lh="xs">余白と暮らし</Heading>
          <Text fz="s" lh="m" c="text-2" max-sz="xs">
            慌ただしい毎日から、少しだけ離れて。光や風を感じながら、自分のペースで過ごす時間。何気ないひとときを大切にする、新しい暮らしのかたちを届けます。
          </Text>
        </Stack>
        <Cluster g="15" jc="end">
          <Button variant="outline" href="#" bdrs="1px" px="30" py="10">Contact us</Button>
        </Cluster>
      </Stack>
    </Columns>
  </Grid>
</DemoLayout>
