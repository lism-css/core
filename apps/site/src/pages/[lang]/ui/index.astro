---
import BaseLayout from '@/layouts/BaseLayout.astro';
import UiComponentCard from '@/components/ui/UiComponentCard.astro';
import { AutoColumns, Lism, Text } from 'lism-css/astro';
import SectionHeader from '@parts/SectionHeader.astro';
import PageHeader from '@parts/PageHeader.astro';
import { getUiPostsByLang } from '@/lib/content';
import { siteConfig } from '@/config/site';
import { isRootLang, isValidLang, type LangCode } from '@/lib/i18n';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));
  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const allUiPosts = await getUiPostsByLang(lang);

const byOrder = (a: (typeof allUiPosts)[number], b: (typeof allUiPosts)[number]) => (a.data.order ?? 999) - (b.data.order ?? 999);

const examplePosts = allUiPosts.filter((post) => post.id.startsWith('ui/examples/')).sort(byOrder);

const blockPosts = allUiPosts.filter((post) => !post.id.startsWith('ui/examples/')).sort(byOrder);

const getPostUrl = (post: (typeof allUiPosts)[number]) => `/${lang}/ui/${post.id.replace('ui/', '')}/`;
---

<BaseLayout title="Lism UI" description="UI components based on Lism CSS — @lism-css/ui" excludeFromSearch>
  <Lism>
    <PageHeader title="Lism UI">
      <Fragment slot="description"
        >A collection of UI components from <code>@lism-css/ui</code>, built on Lism CSS, with implementation examples and samples.</Fragment
      >
    </PageHeader>
    <Lism as="section" mbs="50">
      <SectionHeader title="Blocks">
        <Text>Components available from <code>@lism-css/ui</code>.</Text>
      </SectionHeader>
      <AutoColumns cols="240px" g="30" mbs="40">
        {blockPosts.map((post) => <UiComponentCard href={getPostUrl(post)} title={post.data.title} draft={post.data.draft} />)}
      </AutoColumns>
    </Lism>
    {
      examplePosts.length > 0 && (
        <Lism as="section" mbs="50">
          <SectionHeader title="Examples">
            <Text>Implementation examples of parts and techniques outside the package, built with Lism CSS.</Text>
          </SectionHeader>
          <AutoColumns cols="240px" g="30" mbs="40">
            {examplePosts.map((post) => (
              <UiComponentCard href={getPostUrl(post)} title={post.data.title} draft={post.data.draft} />
            ))}
          </AutoColumns>
        </Lism>
      )
    }
  </Lism>
</BaseLayout>
