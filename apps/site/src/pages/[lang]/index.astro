---
import { CaretRightIcon } from '@lism-css/icons/astro';
import SimpleLayout from '@/layouts/SimpleLayout.astro';
import KvEditor from '@/components/KvEditor/KvEditor.astro';
import { Stack, Lism, Flex, Heading, Text, Link, Columns, Grid, Box, Icon, Center, Media, Frame, Group } from 'lism-css/astro';
import { Button } from '@lism-css/ui/astro/Button';
import { siteConfig } from '@/config/site';
import { getLocalizedUrl, isRootLang, isValidLang, type LangCode } from '@/lib/i18n';
import { getTopShowcaseColumns } from '@/lib/topShowcase';

export async function getStaticPaths() {
  const langCodes = Object.keys(siteConfig.langs) as LangCode[];
  const nonRootLangs = langCodes.filter((lang) => !isRootLang(lang));

  return nonRootLangs.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LangCode;
}

const { lang } = Astro.props as Props;

if (!isValidLang(lang)) {
  return Astro.redirect('/404');
}

const features = [
  {
    title: 'Layout Primitives',
    desc: 'Common layout patterns like Flex, Grid, Stack, and Columns are provided as primitive classes. Combine them to build your site structure in no time.',
    src: '/img/features-layout.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Harmonic Scale',
    desc: 'Spacing, font sizes, line heights, and more are designed with harmonic ratios. The included typography system naturally brings a pleasing rhythm to your designs.',
    src: '/img/features-scale.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Design Tokens',
    desc: 'Values for colors, typography, spacing, border radius, shadows, and more are organized into scales and provided as CSS variables. They maintain consistency across your site and improve reusability.',
    src: '/img/features-tokens.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Property Class',
    desc: 'Each utility class corresponds to a single CSS property and is defined in the clear -prop:value format. This reduces confusion for AI and makes styling intuitive for people.',
    src: '/img/features-props.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'CSS Layer Architecture',
    desc: 'A strict CSS layer design using @layer. It prevents specificity conflicts and helps you organize classes naturally by their roles, supporting both extensibility and maintainability.',
    src: '/img/features-layer.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
  {
    title: 'Responsive',
    desc: 'We developed a unique responsive approach combining classes (-prop_bp) and CSS variables (--prop_bp). It supports a wide range of layouts while keeping file sizes small.',
    src: '/img/features-responsive.png',
    width: 280,
    height: 210,
    ar: '280/210',
    widthBase: '11.25rem',
    widthMd: '15.625rem',
  },
];

const tools = [
  {
    title: 'MCP Server',
    buttonLabel: 'Connect MCP',
    href: '/docs/mcp/',
    body: 'Connect the MCP server to let AI agents search and retrieve Lism CSS specifications. They can look up component usage, props, design tokens, and other information they need while coding.',
    src: '/img/ai-02.png',
    width: 1120,
    height: 840,
  },
  {
    title: 'Skills',
    buttonLabel: 'Install Skills',
    href: '/docs/skills/',
    body: 'Skills that teach AI agents how to use Lism CSS. By correctly understanding Lism CSS’s naming conventions and design principles, AI can generate accurate code that follows best practices.',
    src: '/img/ai-03.png',
    width: 1120,
    height: 840,
  },
];

const showcaseColumns = await getTopShowcaseColumns(lang);
---

<SimpleLayout
  title={siteConfig.name}
  description="Lism CSS is a lightweight CSS framework for building harmonious layouts with ease. Its refined CSS architecture is easy for both humans and AI to use."
  lang={lang}
  schemaType="SoftwareSourceCode"
  excludeFromSearch
>
  {/* inert: Firefoxではvideo要素がフォーカス可能なため、装飾用背景をタブ順から除外 */}
  <Box class="c--kvVideoBg" pos="fixed" i-x="0" t="0" z="-1" h="100vh" ov="hidden" bgc="base" inert aria-hidden="true">
    <Frame h="100%" ar="16/9">
      <video autoplay loop muted playsinline poster="/video/video-kv-poster.webp">
        <source src="/video/video-kv.mp4" type="video/mp4" />
      </video>
    </Frame>
    <Box class="c--kvVideoBlur" pos="absolute" i="0" />
    <Box class="c--kvVideoBlur" pos="absolute" i="0" />
    <Box class="c--kvStripes" pos="absolute" i="0" />
  </Box>
  <Lism as="section" isWrapper="l" px="20">
    {
      /* ヒーローはライブコードエディター（KvEditor）の描画結果。位置決め（上下padding）は
        エディター外なのでレスポンシブ可。任意色・影は _kv-editor.scss の .c--kvEditorHero に集約 */
    }
    <Box pbs={{ base: '9rem', md: '14rem' }} pbe={{ md: '60' }}>
      <KvEditor lang={lang} />
    </Box>
  </Lism>

  {/* 機能紹介 */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Features</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>A Sophisticated Design Theory</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="48em">
        Lism CSS is a lightweight CSS framework for building pleasing layouts quickly and easily. We designed its CSS from the ground up to let a
        mathematically beautiful, harmonious rhythm emerge naturally in your designs.
      </Text>

      <Columns cols={[1, null, 2, 3]} g="10" w="100%" mbs={['50', null, '60']}>
        {
          features.map((card) => (
            <Grid class="b--shadowBox" p={['30', '35', '40']} gtr="1fr auto" g={['40', '50']}>
              <Stack g="25">
                <Heading level="3" class="c--topHeading" fz={['l', 'xl']}>
                  {card.title}
                </Heading>
                <Text fz={['s', 'm']} class="u--trim">
                  {card.desc}
                </Text>
              </Stack>
              <Media
                src={card.src}
                alt=""
                width={card.width}
                height={card.height}
                mx="auto"
                aslf="end"
                ar={card.ar}
                w={{ base: card.widthBase, md: card.widthMd }}
                max-w="100%"
              />
            </Grid>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  {/* AIツール連携 */}
  <Lism as="section" class="c--ai-section" isWrapper="l" hasGutter pos="relative" z="1">
    <Group
      class="c--ai-bg"
      pos="absolute"
      w={['100rem', null, '120rem']}
      l="50%"
      t="0%"
      z="-1"
      max-w="none"
      style={{ translate: '-50% 0%' }}
      aria-hidden="true"
    >
      <Media src="/img/ai-bg.png" alt="" width="2600" height="1559" w="100%" h="auto" />
    </Group>
    <Stack as="div" ai="center" py={['60', null, '70']}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Artificial Intelligence</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>AI Tool Integration</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="48em">
        Lism CSS is designed with AI agents in mind. With an MCP server, Skills, and documentation that AI can easily read, AI coding agents like
        Claude Code, Codex, and Cursor can accurately understand the Lism system and generate code that matches your intent.
      </Text>
      <Frame mt={['45', null, '50']} w={['16rem', '18rem', '20rem', '24rem']} z="1">
        <Media src="/img/ai-01.png" alt="" width="1120" height="840" style={{ filter: 'drop-shadow(1px 3px 2px rgb(0 0 0 / 0.1))' }} />
      </Frame>
      <Columns
        class="b--shadowBox"
        cols={[1, null, 2]}
        g="0"
        pt={{ md: '50' }}
        pb={{ md: '45' }}
        w="100%"
        mt={['45', null, '-3.75rem', '-4.25rem']}
        ov="hidden"
      >
        {
          tools.map((item, index) => (
            <Stack
              px={['30', '35', '40']}
              py={['30', '35', '25']}
              g={['25', null, '30']}
              bd={index > 0}
              bdc="var(--shc)"
              bdw={index > 0 ? { base: '1px 0 0', md: '0 0 0 1px' } : undefined}
            >
              <Flex fxd={['row', null, 'column']} jc="between" ai="center" g={['15', null, '30']}>
                <Heading level="3" class="c--topHeading u--trim" fz={['xl', null, '2xl', '3xl']}>
                  {item.title}
                </Heading>
                <Media src={item.src} alt="" width={item.width} height={item.height} w={['25%', null, '10rem']} h="auto" />
              </Flex>
              <Text fz={['s', 'm']}>{item.body}</Text>
              <Link href={getLocalizedUrl(item.href, lang)} fz={['s', 'm']} mt="auto" aslf="flex-end">
                <span>{item.buttonLabel} →</span>
              </Link>
            </Stack>
          ))
        }
      </Columns>
    </Stack>
  </Lism>

  {/* パターン */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" py={{ base: '60', md: '70' }}>
      <Stack ai="center" g={['25', '30', '35']}>
        <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Lism Patterns</Text>
        <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>Design Patterns</Heading>
      </Stack>
      <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']} max-w="35em">
        We offer website design patterns built with Lism CSS. Simply copy and paste to try them out, and use them as a starting point for your site.
      </Text>
      <Columns cols={3} g="10" ai="start" mbs={{ base: '50', md: '60' }} mx="clamp(-6.375rem, calc(22.921vw - 12.106rem), 0rem)">
        {
          showcaseColumns.map((column) => (
            <Stack g={{ base: '5', md: '10' }}>
              {column.map((item) => (
                <Frame class="b--shadowBox">
                  <Media src={item.src} alt="" width={item.width} height={item.height} />
                </Frame>
              ))}
            </Stack>
          ))
        }
      </Columns>
      <Button class="c--lpButton" href={getLocalizedUrl('/patterns/', lang)} fz={['s', 'm']} hov={{ bgc: 'var(--link)' }} mt="40">
        <span>View More</span>
        <Icon icon={CaretRightIcon} />
      </Button>
    </Stack>
  </Lism>

  {/* CTA */}
  <Lism as="section" isWrapper="l" hasGutter>
    <Stack as="div" ai="center" pt={['60', '70']}>
      <Center class="b--shadowBox" ai="center" w="100%" max-w="l" min-h="min(125vw, calc(100svh - 21.25rem))" px={['30', '40']} py="40">
        <Stack ai="center" g={['25', '30', '35']}>
          <Text class="c--headingEyebrow" fz={['xs', 's', 'm']}>Get Started</Text>
          <Heading level="2" class="c--topHeading u--trim" ta="center" fz={['2xl', '3xl', '4xl']}>Lism CSS Works Everywhere</Heading>
        </Stack>
        <Text class="u--trim" ta="center" mbs={['30', '35', '40']} fz={['s', 'm', 'l']}>
          No build process, no setup required.<br />Just load a single CSS file to add Lism CSS to your site.
        </Text>
        <Button class="c--lpButton" href={getLocalizedUrl('/docs/installation/', lang)} fz={['s', 'm']} hov={{ bgc: 'var(--link)' }} mt="40">
          <span>Get Started</span>
          <Icon icon={CaretRightIcon} />
        </Button>
      </Center>
    </Stack>
  </Lism>
</SimpleLayout>

<style>
  /* トップページは日本語版とフォントスケールを統一（_theme.scss の html[lang='en'] { --fz-mol: 7 } を上書き） */
  :global(html) {
    --fz-mol: 8;
  }
</style>
