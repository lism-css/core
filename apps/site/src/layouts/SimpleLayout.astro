---
import 'lism-css/main.css';

import '../styles/main.scss';

import { siteConfig } from '@/config/site';

import { getRootLang, type LangCode } from '@/lib/i18n';
import type { SchemaType } from '@/lib/jsonLd';

import Head from '../components/Head.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Box, Lism, Stack } from 'lism-css/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: LangCode;
  schemaType?: SchemaType;
  excludeFromSearch?: boolean;
  noindex?: boolean;
  centerMain?: boolean;
}

const { title = siteConfig.name, description, ogImage, lang = getRootLang(), schemaType, noindex = false, centerMain = false } = Astro.props;

// centerMain: main を残りの高さまで広げ、中身を上下中央に寄せる。上下の余白は固定ヘッダーとの重なり防止
const mainProps = centerMain ? ({ layout: 'center', fx: '1', pt: 'calc(var(--header-h) + var(--s50))' } as const) : ({ layout: 'box' } as const);
---

<html lang={lang}>
  <Head title={title || siteConfig.name} description={description} ogImage={ogImage} lang={lang} noindex={noindex}>
    {schemaType && <JsonLd schemaType={schemaType} title={title || siteConfig.name} description={description} lang={lang} />}
  </Head>
  <body data-pagefind-ignore>
    <Stack class="c--root" isContainer min-h="100svh" data-layout="SimpleLayout">
      <Box class="p--front">
        <Header hasMobileMenu={false} hasAllSns={false} />
      </Box>
      <Stack bgc="var(--docs-bg)" pos="relative" z="1" fx="1">
        <Lism as="main" {...mainProps}>
          <slot />
        </Lism>
        <Footer />
      </Stack>
    </Stack>
  </body>
</html>
