---
import 'lism-css/main.css';

import '../styles/main.scss';

import { siteConfig } from '@/config/site';

import { getRootLang, type LangCode } from '@/lib/i18n';
import type { SchemaType } from '@/lib/jsonLd';

import Head from '../components/Head.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Box, Stack } from 'lism-css/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: LangCode;
  schemaType?: SchemaType;
  excludeFromSearch?: boolean;
  noindex?: boolean;
}

const { title = siteConfig.name, description, ogImage, lang = getRootLang(), schemaType, noindex = false } = Astro.props;
---

<html lang={lang}>
  <Head title={title || siteConfig.name} description={description} ogImage={ogImage} lang={lang} noindex={noindex}>
    {schemaType && <JsonLd schemaType={schemaType} title={title || siteConfig.name} description={description} lang={lang} />}
  </Head>
  <body data-pagefind-ignore>
    <Stack class="c--root" isContainer min-h="100svh" data-layout="SimpleLayout">
      <Box class="p--front">
        <Header hasMobileMenu={false} hasAllSns={false} />
      </Box>
      <Box bgc="var(--docs-bg)" pos="relative" z="1">
        <Box as="main">
          <slot />
        </Box>
        <Footer />
      </Box>
    </Stack>
  </body>
</html>
